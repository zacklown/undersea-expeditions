# Copy this file to .env.docker. Keep the database local. To test Vercel Blob
# uploads, set ENABLE_VERCEL_BLOB=true and add only a Blob store token below.
POSTGRES_DB=undersea_payload
POSTGRES_USER=undersea_cms
POSTGRES_PASSWORD=undersea_cms_dev_password
DATABASE_URL=postgresql://undersea_cms:undersea_cms_dev_password@postgres:5432/undersea_payload
PAYLOAD_SECRET=replace-with-a-long-random-local-secret
SERVER_URL=http://localhost:3001
FRONTEND_URL=http://localhost:4321
PAYLOAD_PUBLIC_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:4321
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
PAYLOAD_API_INTERNAL_URL=http://cms:3001/api
PUBLIC_PAYLOAD_API_URL=http://localhost:3001/api
PUBLIC_PAYLOAD_PUBLIC_URL=http://localhost:3001
ENABLE_VERCEL_BLOB=false
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Intentionally blank locally. Production CMS only.
FRONTEND_DEPLOY_HOOK_URL=
