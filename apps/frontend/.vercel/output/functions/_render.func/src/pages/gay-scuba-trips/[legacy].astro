---
import { getTrips } from "../../lib/content";

const { legacy } = Astro.params;
const trips = await getTrips();
const path =
  trips.find((trip) => {
    const legacyUrl = trip.legacyUrl || "";

    if (!legacyUrl.startsWith("/gay-scuba-trips/")) {
      return false;
    }

    const legacySlug = legacyUrl.replace(/^\/gay-scuba-trips\//, "");

    return Boolean(legacy) && legacySlug === legacy;
  })?.path;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    {path && <meta http-equiv="refresh" content={`0;url=${path}`} />}
    {path && <link rel="canonical" href={path} />}
  </head>
  <body>
    {path ? (
      <p>
        Redirecting to <a href={path}>{path}</a>.
      </p>
    ) : (
      <p>Trip not found.</p>
    )}
  </body>
</html>
