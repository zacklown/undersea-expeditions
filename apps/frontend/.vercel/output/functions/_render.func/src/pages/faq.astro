---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { getFAQs, getFAQPageContent } from "../lib/content";

const [pageContent, faqs] = await Promise.all([getFAQPageContent(), getFAQs()]);
---

<Layout title="FAQ | Undersea Expeditions">
  <Header active="faq" />
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-24">
    <div class="text-center mb-16">
      <h1 class="font-display-lg text-display-lg text-primary mb-4">{pageContent.title}</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        {pageContent.description}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-16">
      {pageContent.highlights.map((item) => (
        <div class="p-8 border border-outline-variant/30 rounded-xl hover:bg-surface-container transition-colors">
          <span class="material-symbols-outlined text-on-tertiary-container mb-4">{item.icon}</span>
          <h2 class="font-headline-md text-primary mb-2">{item.title}</h2>
          <p class="text-body-md text-on-surface-variant">{item.description}</p>
        </div>
      ))}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {faqs.map((faq) => (
        <div class="bg-secondary-container/40 rounded-xl p-8">
          <h3 class="font-headline-md text-primary mb-3">{faq.question}</h3>
          <p class="text-body-md text-on-surface-variant">{faq.answer}</p>
        </div>
      ))}
    </div>
  </main>
  <Footer active="faq" />
</Layout>
