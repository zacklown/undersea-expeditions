---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { getTrips, getTripsPageContent } from "../lib/content";

const [pageContent, allTrips] = await Promise.all([getTripsPageContent(), getTrips()]);

const now = new Date();
const currentYear = now.getUTCFullYear();
const currentMonthKey = `${currentYear}-${String(now.getUTCMonth() + 1).padStart(2, "0")}`;
const visibleYears = Array.from({ length: 3 }, (_, index) => currentYear + index);

function getMonthKey(value?: string) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "";

  return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, "0")}`;
}

function getMonthLabel(value?: string) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    timeZone: "UTC",
    year: "numeric",
  }).format(date);
}

function getLocationOptions(trips: Awaited<ReturnType<typeof getTrips>>) {
  const groups = new Map<
    string,
    {
      countries: Map<string, { label: string; value: string }>;
      region: { label: string; value: string };
    }
  >();

  for (const trip of trips) {
    const regionLabel = trip.regionLabel?.trim();

    if (!regionLabel) continue;

    const group =
      groups.get(regionLabel) ||
      {
        countries: new Map(),
        region: {
          label: regionLabel,
          value: `region::${regionLabel}`,
        },
      };

    for (const country of trip.countries) {
      const countryLabel = country?.trim();

      if (!countryLabel) continue;

      group.countries.set(countryLabel, {
        label: countryLabel,
        value: `country::${countryLabel}`,
      });
    }

    groups.set(regionLabel, group);
  }

  return Array.from(groups.entries())
    .sort(([left], [right]) => left.localeCompare(right))
    .map(([, group]) => ({
      ...group,
      countries: Array.from(group.countries.values()).sort((left, right) =>
        left.label.localeCompare(right.label),
      ),
    }));
}

const trips = allTrips
  .filter((trip) => visibleYears.includes(trip.tripYear))
  .filter((trip) => {
    const monthKey = getMonthKey(trip.tripStart);

    return monthKey ? monthKey >= currentMonthKey : trip.tripYear >= currentYear;
  })
  .sort((left, right) => {
    const leftDate = left.tripStart ? new Date(left.tripStart).getTime() : Number.MAX_SAFE_INTEGER;
    const rightDate = right.tripStart ? new Date(right.tripStart).getTime() : Number.MAX_SAFE_INTEGER;

    return leftDate - rightDate;
  });

const locationOptions = getLocationOptions(trips);

const yearCalendars = visibleYears.map((year) => {
  const months = Array.from({ length: 12 }, (_, monthIndex) => {
    const monthValue = `${year}-${String(monthIndex + 1).padStart(2, "0")}`;
    const matchingTrips = trips.filter((trip) => getMonthKey(trip.tripStart) === monthValue);

    return {
      count: matchingTrips.length,
      label: new Intl.DateTimeFormat("en-US", {
        month: "short",
        timeZone: "UTC",
      }).format(new Date(Date.UTC(year, monthIndex, 1))),
      value: monthValue,
    };
  });

  return {
    year,
    hasTrips: months.some((month) => month.count > 0),
    months,
  };
});
---

<Layout title="Trips | Undersea Expeditions">
  <Header active="trips" />
  <main>
    <section class="mx-auto max-w-container-max px-margin-mobile py-16 md:px-margin-desktop md:py-20" data-trip-search>
      <div class="rounded-3xl border border-secondary-fixed/60 bg-white p-6 shadow-sm md:p-8">
        <div class="mb-8 flex flex-col gap-3">
          <h2 class="font-headline-lg text-headline-lg text-primary">Find Your Trip</h2>
          <p class="max-w-3xl text-body-md text-secondary">
            Narrow departures by month, destination, or trip type. Open the calendar to browse this
            year and the next two years. Passed month and year combinations disappear automatically.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)_minmax(0,1fr)_auto] xl:items-end">
          <div class="relative">
            <span class="mb-2 block text-sm font-bold uppercase tracking-[0.14em] text-on-tertiary-container">
              Month and Year
            </span>
            <button
              class="flex w-full items-center justify-between rounded-xl border border-secondary-fixed bg-surface px-4 py-3 text-left text-primary"
              data-calendar-trigger
              type="button"
            >
              <span data-calendar-trigger-label>All future departures</span>
              <span class="material-symbols-outlined text-on-tertiary-container">calendar_month</span>
            </button>
            <input data-filter-months type="hidden" value="" />
            <div class="absolute left-0 top-[calc(100%+0.75rem)] z-20 hidden w-full min-w-[320px] rounded-3xl border border-secondary-fixed/60 bg-white p-4 shadow-[0_24px_80px_rgba(4,44,72,0.16)] xl:w-[720px]" data-calendar-panel>
              <div class="mb-4 flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm font-bold uppercase tracking-[0.14em] text-on-tertiary-container">Departure Calendar</p>
                  <p class="mt-1 text-sm text-secondary">Choose any mix of future months, or click a year to select every available month in it.</p>
                </div>
                <button class="text-sm font-bold text-on-tertiary-container hover:underline" data-calendar-clear type="button">
                  Clear
                </button>
              </div>

              <div class="grid gap-4 lg:grid-cols-3">
                {yearCalendars.map((yearCalendar) => (
                  <section class="overflow-hidden rounded-3xl border border-secondary-fixed/60 bg-white shadow-sm">
                    <button
                      class="flex w-full items-center justify-between border-b border-secondary-fixed/40 bg-primary px-5 py-4 text-left text-white transition-colors hover:bg-on-tertiary-container"
                      data-calendar-year={yearCalendar.year}
                      data-calendar-year-has-trips={yearCalendar.hasTrips ? "true" : "false"}
                      type="button"
                    >
                      <h3 class="font-headline-md text-headline-md">{yearCalendar.year}</h3>
                      {yearCalendar.hasTrips && (
                        <span class="text-xs font-bold uppercase tracking-[0.14em] text-white/80">Select all</span>
                      )}
                    </button>

                    {yearCalendar.hasTrips ? (
                      <div class="grid grid-cols-3 gap-2 p-4">
                        {yearCalendar.months.map((month) => (
                          <button
                            class:list={[
                              "rounded-2xl border px-3 py-3 text-center transition-colors",
                              month.count > 0
                                ? "border-secondary-fixed bg-secondary-container text-primary hover:bg-primary hover:text-white"
                                : "border-secondary-fixed/40 bg-surface text-secondary/45",
                            ]}
                            data-calendar-month={month.count > 0 ? month.value : undefined}
                            data-calendar-month-label={month.count > 0 ? `${month.label} ${yearCalendar.year}` : undefined}
                            disabled={month.count === 0}
                            type="button"
                          >
                            <span class="block text-sm font-bold uppercase tracking-[0.14em]">{month.label}</span>
                            <span class="mt-1.5 inline-block whitespace-nowrap text-[11px]">
                              {month.count > 0 ? `${month.count} trip${month.count === 1 ? "" : "s"}` : " "}
                            </span>
                          </button>
                        ))}
                      </div>
                    ) : (
                      <div class="flex min-h-[210px] items-center justify-center p-6 text-center">
                        <div>
                          <p class="text-label-sm font-label-sm uppercase tracking-[0.18em] text-on-tertiary-container">
                            {yearCalendar.year}
                          </p>
                          <p class="mt-3 font-headline-md text-headline-md text-primary">Coming Soon</p>
                        </div>
                      </div>
                    )}
                  </section>
                ))}
              </div>
            </div>
          </div>

          <div class="relative">
            <span class="mb-2 block text-sm font-bold uppercase tracking-[0.14em] text-on-tertiary-container">
              Location / Region
            </span>
            <button
              class="flex w-full items-center justify-between rounded-xl border border-secondary-fixed bg-surface px-4 py-3 text-left text-primary"
              data-location-trigger
              type="button"
            >
              <span data-location-trigger-label>All locations</span>
              <span class="material-symbols-outlined text-on-tertiary-container">expand_more</span>
            </button>
            <input data-filter-locations type="hidden" value="" />
            <div
              class="absolute left-0 top-[calc(100%+0.75rem)] z-20 hidden w-full rounded-3xl border border-secondary-fixed/60 bg-white p-3 shadow-[0_24px_80px_rgba(4,44,72,0.16)]"
              data-location-panel
            >
              <div class="mb-2 flex items-center justify-between gap-4 px-2 py-1">
                <p class="text-sm font-bold uppercase tracking-[0.14em] text-on-tertiary-container">
                  Browse Regions
                </p>
                <button
                  class="text-sm font-bold text-on-tertiary-container hover:underline"
                  data-location-clear
                  type="button"
                >
                  Clear
                </button>
              </div>

              <div class="max-h-[320px] space-y-3 overflow-y-auto pr-1">
                {locationOptions.map((group) => (
                  <div class="border-b border-secondary-fixed/30 pb-3 last:border-b-0 last:pb-0">
                    <button
                      class="flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-primary transition-colors hover:bg-secondary-container"
                      data-location-region={group.region.value}
                      data-location-region-label={group.region.label}
                      type="button"
                    >
                      <span class="font-bold uppercase tracking-[0.1em]">{group.region.label}</span>
                    </button>

                    <div class="mt-1 space-y-1">
                      {group.countries.map((option) => (
                        <button
                          class="flex w-full items-center rounded-xl px-3 py-2 pl-8 text-left text-secondary transition-colors hover:bg-secondary-container hover:text-primary"
                          data-location-option={option.value}
                          data-location-label={option.label}
                          data-location-parent={group.region.value}
                          type="button"
                        >
                          <span class="mr-2 text-on-tertiary-container/70">-</span>
                          <span>{option.label}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="relative">
            <span class="mb-2 block text-sm font-bold uppercase tracking-[0.14em] text-on-tertiary-container">
              Trip Type
            </span>
            <button
              class="flex w-full items-center justify-between rounded-xl border border-secondary-fixed bg-surface px-4 py-3 text-left text-primary"
              data-gender-trigger
              type="button"
            >
              <span data-gender-trigger-label>All trips</span>
              <span class="material-symbols-outlined text-on-tertiary-container">expand_more</span>
            </button>
            <input data-filter-genders type="hidden" value="" />
            <div
              class="absolute left-0 top-[calc(100%+0.75rem)] z-20 hidden w-full rounded-3xl border border-secondary-fixed/60 bg-white p-3 shadow-[0_24px_80px_rgba(4,44,72,0.16)]"
              data-gender-panel
            >
              <div class="mb-2 flex items-center justify-between gap-4 px-2 py-1">
                <p class="text-sm font-bold uppercase tracking-[0.14em] text-on-tertiary-container">
                  Trip Type
                </p>
                <button
                  class="text-sm font-bold text-on-tertiary-container hover:underline"
                  data-gender-clear
                  type="button"
                >
                  Clear
                </button>
              </div>

              <div class="space-y-1">
                <button
                  class="flex w-full items-center rounded-xl px-3 py-2 text-left text-secondary transition-colors hover:bg-secondary-container hover:text-primary"
                  data-gender-option=""
                  data-gender-label="All trips"
                  type="button"
                >
                  All trips
                </button>
                <button
                  class="flex w-full items-center rounded-xl px-3 py-2 text-left text-secondary transition-colors hover:bg-secondary-container hover:text-primary"
                  data-gender-option="male"
                  data-gender-label="Men Only"
                  type="button"
                >
                  Men Only
                </button>
                <button
                  class="flex w-full items-center rounded-xl px-3 py-2 text-left text-secondary transition-colors hover:bg-secondary-container hover:text-primary"
                  data-gender-option="mixed"
                  data-gender-label="Coed"
                  type="button"
                >
                  Coed
                </button>
                <button
                  class="flex w-full items-center rounded-xl px-3 py-2 text-left text-secondary transition-colors hover:bg-secondary-container hover:text-primary"
                  data-gender-option="female"
                  data-gender-label="For Women Only"
                  type="button"
                >
                  For Women Only
                </button>
              </div>
            </div>
          </div>

          <div>
            <button
              class="inline-flex w-full items-center justify-center rounded-xl bg-primary px-6 py-3 font-bold text-white transition-colors hover:bg-on-tertiary-container"
              data-view-results
              type="button"
            >
              View {trips.length} trips
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-container-max px-margin-mobile pb-20 md:px-margin-desktop" id="trip-results">
      <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="font-headline-lg text-headline-lg text-primary">Available Departures</h2>
          <p class="mt-2 text-body-md text-secondary">
            <span data-results-count>{trips.length}</span> matching trip<span data-results-plural>s</span>
          </p>
        </div>
      </div>

      <div class="hidden rounded-2xl border border-dashed border-secondary-fixed/70 bg-surface-container-low px-6 py-10 text-center" data-empty-state>
        <p class="font-headline-md text-headline-md text-primary">No trips match those filters yet.</p>
        <p class="mt-3 text-body-md text-secondary">Try another month, destination, or trip type.</p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3" data-trip-results>
        {trips.map((trip) => (
          <a
            class="group block overflow-hidden rounded-2xl border border-secondary-fixed bg-white shadow-sm transition-shadow hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-4"
            data-trip-card
            data-trip-countries={trip.countries.join("|")}
            data-trip-gender={trip.gender || ""}
            data-trip-month={getMonthKey(trip.tripStart)}
            data-trip-region={trip.regionLabel}
            data-trip-year={trip.tripYear}
            href={trip.path}
          >
            <article class="relative flex h-[39rem] flex-col">
              <div class="relative h-60 overflow-hidden md:h-64">
                <img alt={trip.coverImage.alt || trip.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" src={trip.coverImage.url} />
                <div class="absolute left-4 top-4 rounded bg-white/90 px-3 py-1 text-label-sm font-label-sm text-primary backdrop-blur-md">{trip.regionLabel}</div>
                {trip.isNew && (
                  <div class="absolute right-4 top-4 rounded bg-on-tertiary-container px-3 py-1 text-label-sm font-label-sm text-white">New</div>
                )}
                {trip.statusLabel && (
                  <div class={`absolute right-4 rounded bg-primary px-3 py-1 text-label-sm font-label-sm text-white ${trip.isNew ? "top-14" : "top-4"}`}>
                    {trip.statusLabel}
                  </div>
                )}
              </div>
              <div aria-hidden="true" class="rainbow-divider h-1 w-full shrink-0"></div>
              <div class="flex flex-1 flex-col overflow-hidden p-6">
                <h3 class="mb-2 min-h-[5.5rem] font-headline-md text-headline-md text-primary [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                  {trip.title}
                </h3>
                <p class="mb-2 min-h-[3rem] text-secondary [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                  {trip.countries.join(", ")}
                </p>
                <p class="mb-4 min-h-[3rem] font-bold text-on-tertiary-container [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                  {trip.dateLabel}
                </p>
                {trip.groupTypeLabel && (
                  <p class="mb-4 text-sm font-bold uppercase tracking-[0.14em] text-on-tertiary-container">
                    {trip.groupTypeLabel}
                  </p>
                )}
                <p class="mb-6 h-[7.5rem] overflow-hidden font-body-md text-body-md leading-6 text-secondary [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:5]">
                  {trip.summary}
                </p>
                <span class="mt-auto block w-full rounded-lg border border-primary py-3 text-center font-bold text-primary transition-all group-hover:bg-primary group-hover:text-white">
                  Contact Us
                </span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer active="trips" />
</Layout>

<script>
  const searchRoot = document.querySelector("[data-trip-search]");
  const resultsRoot = document.querySelector("[data-trip-results]");
  const cards = Array.from(document.querySelectorAll("[data-trip-card]"));
  const monthsInput = searchRoot?.querySelector("[data-filter-months]");
  const calendarTrigger = searchRoot?.querySelector("[data-calendar-trigger]");
  const calendarTriggerLabel = searchRoot?.querySelector("[data-calendar-trigger-label]");
  const calendarPanel = searchRoot?.querySelector("[data-calendar-panel]");
  const calendarClear = searchRoot?.querySelector("[data-calendar-clear]");
  const locationInput = searchRoot?.querySelector("[data-filter-locations]");
  const locationTrigger = searchRoot?.querySelector("[data-location-trigger]");
  const locationTriggerLabel = searchRoot?.querySelector("[data-location-trigger-label]");
  const locationPanel = searchRoot?.querySelector("[data-location-panel]");
  const locationClear = searchRoot?.querySelector("[data-location-clear]");
  const genderInput = searchRoot?.querySelector("[data-filter-genders]");
  const genderTrigger = searchRoot?.querySelector("[data-gender-trigger]");
  const genderTriggerLabel = searchRoot?.querySelector("[data-gender-trigger-label]");
  const genderPanel = searchRoot?.querySelector("[data-gender-panel]");
  const genderClear = searchRoot?.querySelector("[data-gender-clear]");
  const viewButton = searchRoot?.querySelector("[data-view-results]");
  const resultsCount = document.querySelector("[data-results-count]");
  const resultsPlural = document.querySelector("[data-results-plural]");
  const emptyState = document.querySelector("[data-empty-state]");
  const calendarButtons = Array.from(document.querySelectorAll("[data-calendar-month]"));
  const yearButtons = Array.from(document.querySelectorAll("[data-calendar-year]"));
  const locationRegionButtons = Array.from(document.querySelectorAll("[data-location-region]"));
  const locationButtons = Array.from(document.querySelectorAll("[data-location-option]"));
  const genderButtons = Array.from(document.querySelectorAll("[data-gender-option]"));

  const updateButtonLabel = (count) => {
    if (!viewButton) return;

    viewButton.textContent = `View ${count} trip${count === 1 ? "" : "s"}`;
  };

  const getFilterValues = (source) => ({
    genders: Array.isArray(source.genders) ? source.genders : [],
    locations: Array.isArray(source.locations) ? source.locations : [],
    months: Array.isArray(source.months) ? source.months : [],
  });

  let appliedFilters = {
    genders: [],
    locations: [],
    months: [],
  };

  let pendingMonths = new Set();
  let pendingLocations = new Set();
  let pendingGenders = new Set();

  const writePendingMonths = () => {
    if (!(monthsInput instanceof HTMLInputElement)) return;

    monthsInput.value = Array.from(pendingMonths).sort().join("|");
  };

  const writePendingLocations = () => {
    if (!(locationInput instanceof HTMLInputElement)) return;

    locationInput.value = Array.from(pendingLocations).sort().join("|");
  };

  const writePendingGenders = () => {
    if (!(genderInput instanceof HTMLInputElement)) return;

    genderInput.value = Array.from(pendingGenders).sort().join("|");
  };

  const getPendingFilters = () =>
    getFilterValues({
      genders: Array.from(pendingGenders),
      locations: Array.from(pendingLocations),
      months: Array.from(pendingMonths),
    });

  const getMatchingCards = (filters) =>
    cards.filter((card) => {
      const tripMonth = card.getAttribute("data-trip-month") || "";
      const tripRegion = card.getAttribute("data-trip-region") || "";
      const tripCountries = (card.getAttribute("data-trip-countries") || "").split("|").filter(Boolean);
      const tripGender = card.getAttribute("data-trip-gender") || "";
      let matchesLocation = true;

      if (filters.locations.length) {
        matchesLocation = filters.locations.some((location) => {
          const [type, value] = location.split("::");
          return type === "region" ? tripRegion === value : tripCountries.includes(value);
        });
      }

      const matchesMonth = !filters.months.length || filters.months.includes(tripMonth);

      const matchesGender = !filters.genders.length || filters.genders.includes(tripGender);

      return matchesMonth && matchesLocation && matchesGender;
    });

  const getYearMonthButtons = (year) =>
    calendarButtons.filter((button) => (button.getAttribute("data-calendar-month") || "").startsWith(`${year}-`));

  const syncCalendarUI = () => {
    writePendingMonths();

    calendarButtons.forEach((button) => {
      const monthValue = button.getAttribute("data-calendar-month") || "";
      const isActive = pendingMonths.has(monthValue);

      button.classList.toggle("bg-primary", isActive);
      button.classList.toggle("text-white", isActive);
      button.classList.toggle("border-primary", isActive);
      button.classList.toggle("bg-secondary-container", !isActive);
      button.classList.toggle("text-primary", !isActive);
      button.classList.toggle("border-secondary-fixed", !isActive);
    });

    yearButtons.forEach((button) => {
      const year = button.getAttribute("data-calendar-year") || "";
      const yearMonths = getYearMonthButtons(year).map((monthButton) => monthButton.getAttribute("data-calendar-month") || "");
      const hasTrips = button.getAttribute("data-calendar-year-has-trips") === "true";
      const allSelected = yearMonths.length > 0 && yearMonths.every((month) => pendingMonths.has(month));

      button.classList.toggle("bg-on-tertiary-container", allSelected && hasTrips);
      const helperText = button.querySelector("span");
      if (helperText instanceof HTMLElement && hasTrips) {
        helperText.textContent = allSelected ? "Clear year" : "Select all";
      }
    });
  };

  const updateCalendarLabel = () => {
    if (!(calendarTriggerLabel instanceof HTMLElement)) {
      return;
    }

    const selectedMonths = Array.from(pendingMonths).sort();

    if (!selectedMonths.length) {
      calendarTriggerLabel.textContent = "All future departures";
      return;
    }

    if (selectedMonths.length === 1) {
      const activeButton = calendarPanel?.querySelector(`[data-calendar-month="${selectedMonths[0]}"]`);
      const label = activeButton?.getAttribute("data-calendar-month-label");
      calendarTriggerLabel.textContent = label || "1 month selected";
      return;
    }

    calendarTriggerLabel.textContent = `${selectedMonths.length} months selected`;
  };

  const getRegionChildButtons = (regionValue) =>
    locationButtons.filter(
      (button) => (button.getAttribute("data-location-parent") || "") === regionValue,
    );

  const syncLocationUI = () => {
    writePendingLocations();

    locationButtons.forEach((button) => {
      const buttonValue = button.getAttribute("data-location-option") || "";
      const isActive = pendingLocations.has(buttonValue);

      button.classList.toggle("bg-primary", isActive);
      button.classList.toggle("text-white", isActive);
      button.classList.toggle("hover:bg-primary", isActive);
      button.classList.toggle("hover:text-white", isActive);
      button.classList.toggle("text-secondary", !isActive);
    });

    locationRegionButtons.forEach((button) => {
      const regionValue = button.getAttribute("data-location-region") || "";
      const childValues = getRegionChildButtons(regionValue).map(
        (childButton) => childButton.getAttribute("data-location-option") || "",
      );
      const allSelected =
        childValues.length > 0 && childValues.every((value) => pendingLocations.has(value));

      button.classList.toggle("bg-primary", allSelected);
      button.classList.toggle("text-white", allSelected);
      button.classList.toggle("bg-secondary-container", !allSelected);
    });

    if (!(locationTriggerLabel instanceof HTMLElement)) return;

    if (!pendingLocations.size) {
      locationTriggerLabel.textContent = "All locations";
      return;
    }

    if (pendingLocations.size === 1) {
      const activeButton = locationButtons.find((button) =>
        pendingLocations.has(button.getAttribute("data-location-option") || ""),
      );
      locationTriggerLabel.textContent =
        activeButton?.getAttribute("data-location-label") || "1 location selected";
      return;
    }

    locationTriggerLabel.textContent = `${pendingLocations.size} locations selected`;
  };

  const syncGenderUI = () => {
    writePendingGenders();

    genderButtons.forEach((button) => {
      const buttonValue = button.getAttribute("data-gender-option") || "";
      const isActive = pendingGenders.has(buttonValue);

      button.classList.toggle("bg-primary", isActive);
      button.classList.toggle("text-white", isActive);
      button.classList.toggle("hover:bg-primary", isActive);
      button.classList.toggle("hover:text-white", isActive);
      button.classList.toggle("text-secondary", !isActive);
    });

    if (!(genderTriggerLabel instanceof HTMLElement)) return;

    if (!pendingGenders.size) {
      genderTriggerLabel.textContent = "All trips";
      return;
    }

    if (pendingGenders.size === 1) {
      const activeButton = genderButtons.find((button) =>
        pendingGenders.has(button.getAttribute("data-gender-option") || ""),
      );
      genderTriggerLabel.textContent =
        activeButton?.getAttribute("data-gender-label") || "1 trip type selected";
      return;
    }

    genderTriggerLabel.textContent = `${pendingGenders.size} trip types selected`;
  };

  const updatePendingCount = () => {
    const count = getMatchingCards(getPendingFilters()).length;
    syncCalendarUI();
    syncLocationUI();
    syncGenderUI();
    updateCalendarLabel();
    updateButtonLabel(count);
  };

  const closePanels = (options = {}) => {
    const { keepCalendar = false, keepLocation = false, keepGender = false } = options;

    if (!keepCalendar && calendarPanel instanceof HTMLElement) {
      calendarPanel.classList.add("hidden");
    }

    if (!keepLocation && locationPanel instanceof HTMLElement) {
      locationPanel.classList.add("hidden");
    }

    if (!keepGender && genderPanel instanceof HTMLElement) {
      genderPanel.classList.add("hidden");
    }
  };

  const renderAppliedResults = () => {
    const matchingCards = new Set(getMatchingCards(appliedFilters));

    cards.forEach((card) => {
      card.classList.toggle("hidden", !matchingCards.has(card));
    });

    const count = matchingCards.size;

    if (resultsCount) resultsCount.textContent = String(count);
    if (resultsPlural) resultsPlural.textContent = count === 1 ? "" : "s";
    if (emptyState) emptyState.classList.toggle("hidden", count !== 0);
    if (resultsRoot) resultsRoot.classList.toggle("hidden", count === 0);
  };

  if (calendarTrigger instanceof HTMLButtonElement && calendarPanel instanceof HTMLElement) {
    calendarTrigger.addEventListener("click", () => {
      const willOpen = calendarPanel.classList.contains("hidden");
      closePanels({ keepCalendar: true });
      calendarPanel.classList.toggle("hidden", !willOpen);
    });

    document.addEventListener("click", (event) => {
      if (!searchRoot?.contains(event.target)) {
        closePanels();
      }
    });
  }

  if (locationTrigger instanceof HTMLButtonElement && locationPanel instanceof HTMLElement) {
    locationTrigger.addEventListener("click", () => {
      const willOpen = locationPanel.classList.contains("hidden");
      closePanels({ keepLocation: true });
      locationPanel.classList.toggle("hidden", !willOpen);
    });

    document.addEventListener("click", (event) => {
      if (!searchRoot?.contains(event.target)) {
        closePanels();
      }
    });
  }

  if (genderTrigger instanceof HTMLButtonElement && genderPanel instanceof HTMLElement) {
    genderTrigger.addEventListener("click", () => {
      const willOpen = genderPanel.classList.contains("hidden");
      closePanels({ keepGender: true });
      genderPanel.classList.toggle("hidden", !willOpen);
    });
  }

  if (calendarClear instanceof HTMLButtonElement && calendarPanel instanceof HTMLElement) {
    calendarClear.addEventListener("click", () => {
      pendingMonths = new Set();
      updatePendingCount();
    });
  }

  calendarButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const monthValue = button.getAttribute("data-calendar-month") || "";

      if (!monthValue) return;

      if (pendingMonths.has(monthValue)) {
        pendingMonths.delete(monthValue);
      } else {
        pendingMonths.add(monthValue);
      }

      updatePendingCount();
    });
  });

  yearButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (button.getAttribute("data-calendar-year-has-trips") !== "true") return;

      const year = button.getAttribute("data-calendar-year") || "";
      const yearMonths = getYearMonthButtons(year).map((monthButton) => monthButton.getAttribute("data-calendar-month") || "");
      const allSelected = yearMonths.length > 0 && yearMonths.every((month) => pendingMonths.has(month));

      yearMonths.forEach((month) => {
        if (!month) return;

        if (allSelected) {
          pendingMonths.delete(month);
        } else {
          pendingMonths.add(month);
        }
      });

      updatePendingCount();
    });
  });

  if (locationClear instanceof HTMLButtonElement) {
    locationClear.addEventListener("click", () => {
      pendingLocations = new Set();
      updatePendingCount();
    });
  }

  locationRegionButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const regionValue = button.getAttribute("data-location-region") || "";
      const childValues = getRegionChildButtons(regionValue).map(
        (childButton) => childButton.getAttribute("data-location-option") || "",
      );
      const allSelected =
        childValues.length > 0 && childValues.every((value) => pendingLocations.has(value));

      childValues.forEach((value) => {
        if (!value) return;

        if (allSelected) {
          pendingLocations.delete(value);
        } else {
          pendingLocations.add(value);
        }
      });

      updatePendingCount();
    });
  });

  locationButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const value = button.getAttribute("data-location-option") || "";

      if (pendingLocations.has(value)) {
        pendingLocations.delete(value);
      } else {
        pendingLocations.add(value);
      }

      updatePendingCount();
    });
  });

  if (genderClear instanceof HTMLButtonElement) {
    genderClear.addEventListener("click", () => {
      pendingGenders = new Set();
      updatePendingCount();
    });
  }

  genderButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const value = button.getAttribute("data-gender-option") || "";

      if (!value) {
        pendingGenders = new Set();
        updatePendingCount();
        return;
      }

      if (pendingGenders.has(value)) {
        pendingGenders.delete(value);
      } else {
        pendingGenders.add(value);
      }

      updatePendingCount();
    });
  });

  if (viewButton) {
    viewButton.addEventListener("click", () => {
      appliedFilters = getPendingFilters();
      renderAppliedResults();
      document.getElementById("trip-results")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  updatePendingCount();
  renderAppliedResults();
</script>
