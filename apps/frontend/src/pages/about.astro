---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { getAboutPageContent } from "../lib/content";

const pageContent = await getAboutPageContent();
const hasStaffSection =
  pageContent.staffSection.officeStaff.length > 0 ||
  pageContent.staffSection.tripLeaders.length > 0;
const hasPressSection = pageContent.pressSection.items.length > 0;
---

<Layout
  title={`${pageContent.title || "About Us"} | Undersea Expeditions`}
  bodyClass="bg-background text-on-surface font-body-md selection:bg-on-tertiary-container selection:text-white"
>
  <Header active="about" />
  <main>
    <section class="relative min-h-[420px] overflow-hidden py-24">
      <img
        class="absolute inset-0 h-full w-full object-cover"
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuAf78J9Nd4mM0OC1BkmCBaQVt7kjRW-4a0kgSLfR6mbJfN-QU9ioHxsnv0hf7YbcNsYW4pJG8PSH5OFdeoSXBIzriL15402T3HhK0zaf0tOSn4RlgZPTtqRUbc5kPu6Xjbk1nJz_oUtDHmq5bXz-mI1yPx3H575mIjV7KHUJemZWtw1gX8_mZF4oVhUS0TJhwk24dLnFJAcrWQSTPcxgTA1vZ4z-v0m-NOyqJb4TiPRMQK_EmP1Tnpr_FFpJArJa74s1BgOBSPB7YeL"
        alt="Luxury scuba expedition at sunset"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-primary/70 via-primary/45 to-primary/25"></div>
      <div class="relative z-10 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="max-w-3xl text-white">
          <span class="mb-4 block font-label-sm text-label-sm uppercase tracking-widest text-tertiary-fixed">
            About
          </span>
          {pageContent.title && (
            <h1 class="font-display-lg text-display-lg mb-6 leading-tight text-white">
              {pageContent.title}
            </h1>
          )}
        </div>
      </div>
    </section>

    {pageContent.body && (
      <section class="py-section-padding px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="rounded-[32px] border border-secondary-fixed/40 bg-white p-8 shadow-[0_24px_70px_rgba(4,44,72,0.10)] md:p-12">
          <div
            class="prose prose-lg max-w-none prose-headings:text-primary prose-p:text-on-surface-variant prose-strong:text-primary prose-a:text-on-tertiary-container"
            set:html={pageContent.body}
          />
        </div>
      </section>
    )}

    {hasStaffSection && (
      <section class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto pb-section-padding">
        <div class="mb-10 max-w-3xl">
          {pageContent.staffSection.title && (
            <h2 class="font-headline-lg text-headline-lg text-primary">
              {pageContent.staffSection.title}
            </h2>
          )}
          {pageContent.staffSection.description && (
            <p class="mt-3 text-body-lg text-on-surface-variant">
              {pageContent.staffSection.description}
            </p>
          )}
        </div>

        {pageContent.staffSection.officeStaff.length > 0 && (
          <div class="mb-14">
            <h3 class="mb-6 font-headline-md text-headline-md text-primary">
              {pageContent.staffSection.officeTitle}
            </h3>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
              {pageContent.staffSection.officeStaff.map((member) => (
                <article class="overflow-hidden rounded-3xl border border-secondary-fixed/50 bg-white shadow-sm">
                  {member.image?.url && (
                    <img
                      alt={member.image.alt || member.name}
                      class="aspect-[4/3] w-full object-cover"
                      src={member.image.url}
                    />
                  )}
                  <div class="p-6">
                    <h4 class="font-headline-md text-headline-md text-primary">{member.name}</h4>
                    {member.role && (
                      <p class="mt-2 text-label-sm uppercase tracking-[0.18em] text-on-tertiary-container">
                        {member.role}
                      </p>
                    )}
                    {member.bio && (
                      <div
                        class="prose mt-4 max-w-none prose-p:text-on-surface-variant prose-strong:text-primary"
                        set:html={member.bio}
                      />
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {pageContent.staffSection.tripLeaders.length > 0 && (
          <div>
            <h3 class="mb-6 font-headline-md text-headline-md text-primary">
              {pageContent.staffSection.tripLeadersTitle}
            </h3>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
              {pageContent.staffSection.tripLeaders.map((member) => (
                <article class="overflow-hidden rounded-3xl border border-secondary-fixed/50 bg-white shadow-sm">
                  {member.image?.url && (
                    <img
                      alt={member.image.alt || member.name}
                      class="aspect-[4/3] w-full object-cover"
                      src={member.image.url}
                    />
                  )}
                  <div class="p-6">
                    <h4 class="font-headline-md text-headline-md text-primary">{member.name}</h4>
                    {member.role && (
                      <p class="mt-2 text-label-sm uppercase tracking-[0.18em] text-on-tertiary-container">
                        {member.role}
                      </p>
                    )}
                    {member.bio && (
                      <div
                        class="prose mt-4 max-w-none prose-p:text-on-surface-variant prose-strong:text-primary"
                        set:html={member.bio}
                      />
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    {hasPressSection && (
      <section class="bg-primary py-section-padding text-white">
        <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
          <div class="mb-10 max-w-3xl">
            {pageContent.pressSection.title && (
              <h2 class="font-headline-lg text-headline-lg text-tertiary-fixed">
                {pageContent.pressSection.title}
              </h2>
            )}
            {pageContent.pressSection.description && (
              <p class="mt-3 text-body-lg text-primary-fixed/85">
                {pageContent.pressSection.description}
              </p>
            )}
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {pageContent.pressSection.items.map((item) => {
              const href = item.pdf?.url || item.externalUrl;

              return (
                <article class="rounded-3xl border border-white/15 bg-white/10 p-6 backdrop-blur-sm">
                  <h3 class="font-headline-md text-headline-md text-white">{item.title}</h3>
                  {item.description && (
                    <p class="mt-3 text-body-md text-primary-fixed/85">{item.description}</p>
                  )}
                  {href && (
                    <a
                      class="mt-5 inline-flex items-center rounded-full bg-tertiary-fixed px-5 py-3 font-bold text-primary transition-opacity hover:opacity-90"
                      href={href}
                      rel="noreferrer"
                      target="_blank"
                    >
                      {item.ctaLabel || (item.pdf ? "Open PDF" : "Open Link")}
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer active="about" />
</Layout>
