---
import { getTripBySlug, getTrips } from "../../lib/content";

export async function getStaticPaths() {
  const trips = await getTrips();

  return trips.map((trip) => ({
    params: { slug: trip.slug },
    props: { path: trip.path },
  }));
}

const { slug } = Astro.params;
const { path } = Astro.props as { path?: string };
const trip = !path && slug ? await getTripBySlug(slug) : null;
const redirectPath = path || trip?.path;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting...</title>
    {redirectPath && <meta http-equiv="refresh" content={`0;url=${redirectPath}`} />}
    {redirectPath && <link rel="canonical" href={redirectPath} />}
  </head>
  <body>
    {redirectPath ? (
      <p>
        Redirecting to <a href={redirectPath}>{redirectPath}</a>.
      </p>
    ) : (
      <p>Trip not found.</p>
    )}
  </body>
</html>
