---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { getSocialsPageContent } from "../lib/content";

const pageContent = await getSocialsPageContent();
const hasSocialLinks = pageContent.socialLinks.length > 0;
const hasMomentTiles = pageContent.latestSocialMoments.tiles.length > 0;

function normalizeUrl(value?: string) {
  if (!value) return "";

  const trimmed = value.trim();

  if (!trimmed) return "";

  if (/^https?:\/\//i.test(trimmed)) return trimmed;

  return `https://${trimmed.replace(/^\/+/, "")}`;
}

function getSocialPlatform(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "generic";

  try {
    const hostname = new URL(normalized).hostname.replace(/^www\./, "").toLowerCase();

    if (hostname.includes("instagram.com")) return "instagram";
    if (hostname.includes("facebook.com")) return "facebook";
    if (hostname.includes("tiktok.com")) return "tiktok";
    if (hostname.includes("youtube.com") || hostname.includes("youtu.be")) return "youtube";
  } catch {
    return "generic";
  }

  return "generic";
}

function getInstagramHandle(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "";

  try {
    const { pathname } = new URL(normalized);
    const [firstSegment] = pathname.split("/").filter(Boolean);

    if (!firstSegment || ["p", "reel", "tv", "stories"].includes(firstSegment)) return "";

    return firstSegment;
  } catch {
    return "";
  }
}

function getInstagramEmbedUrl(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "";

  try {
    const url = new URL(normalized);
    const segments = url.pathname.split("/").filter(Boolean);
    const [firstSegment, secondSegment] = segments;

    if (!firstSegment) return "";

    if (["p", "reel", "tv"].includes(firstSegment) && secondSegment) {
      return `https://www.instagram.com/${firstSegment}/${secondSegment}/embed/captioned/`;
    }
  } catch {
    return "";
  }

  return "";
}

function getFacebookPageEmbedUrl(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "";

  return `https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(
    normalized,
  )}&tabs=timeline&width=500&height=720&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=false`;
}

function getFacebookPostEmbedUrl(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "";

  return `https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(
    normalized,
  )}&show_text=true&width=500`;
}

function getTikTokVideoId(value?: string) {
  const normalized = normalizeUrl(value);
  const match = normalized.match(/\/video\/(\d+)/);
  return match?.[1] || "";
}

function getYouTubeVideoId(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "";

  try {
    const url = new URL(normalized);
    if (url.hostname.includes("youtu.be")) return url.pathname.split("/").filter(Boolean)[0] || "";
    if (url.pathname.startsWith("/shorts/")) return url.pathname.split("/").filter(Boolean)[1] || "";
    return url.searchParams.get("v") || "";
  } catch {
    return "";
  }
}
---

<Layout title={`${pageContent.title || "Socials"} | Undersea Expeditions`}>
  <Header active="socials" />
  <main>
    <section class="mx-auto max-w-container-max px-margin-mobile py-16 md:px-margin-desktop md:py-24">
      <div class="max-w-3xl">
        {pageContent.title && (
          <h1 class="mb-6 text-[clamp(3rem,7vw,5rem)] leading-[1.02] tracking-[-0.03em] text-primary">{pageContent.title}</h1>
        )}
        {pageContent.description && (
          <p class="font-body-lg text-body-lg text-on-surface-variant">{pageContent.description}</p>
        )}
      </div>
    </section>

    {hasSocialLinks && (
      <section class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
        <div class="border-t border-outline-variant/70">
          {pageContent.socialLinks.map((social) => (
            <article class="grid gap-8 border-b border-outline-variant/70 py-10 lg:grid-cols-[minmax(220px,0.32fr)_minmax(0,0.68fr)] lg:gap-14">
              <div>
                <h2 class="text-3xl leading-10 text-primary">{social.title}</h2>
                {social.description && (
                  <p class="mt-3 text-body-md text-on-surface-variant">{social.description}</p>
                )}
              </div>
              <div class="min-w-0">
                {getSocialPlatform(social.href) === "facebook" && social.href ? (
                  <div class="overflow-hidden border border-outline-variant/40 bg-white">
                    <iframe
                      title={social.title}
                      src={getFacebookPageEmbedUrl(social.href)}
                      width="500"
                      height="720"
                      class="h-[720px] w-full"
                      style="border:none;overflow:hidden"
                      allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                    />
                  </div>
                ) : getSocialPlatform(social.href) === "instagram" && getInstagramEmbedUrl(social.href) ? (
                  <div class="overflow-hidden border border-outline-variant/40 bg-white">
                    <iframe
                      title={social.title}
                      src={getInstagramEmbedUrl(social.href)}
                      class="h-[720px] w-full"
                      style="border:none;overflow:hidden"
                      allowtransparency="true"
                    />
                  </div>
                ) : getSocialPlatform(social.href) === "instagram" ? (
                  <div class="border border-outline-variant/40 bg-white p-6">
                    <blockquote
                      class="instagram-media mx-auto !min-w-0 !w-full !max-w-full"
                      data-instgrm-permalink={normalizeUrl(social.href)}
                      data-instgrm-version="14"
                      style="background:#FFF;border:0;box-shadow:none;margin:0 auto;max-width:540px;padding:0;width:100%;"
                    >
                      <div class="flex min-h-[26rem] flex-col items-center justify-center border border-dashed border-outline-variant/30 bg-white px-8 py-10 text-center">
                        <p class="mb-3 font-headline-md text-headline-md text-primary">
                          {getInstagramHandle(social.href)
                            ? `@${getInstagramHandle(social.href)}`
                            : "Instagram Profile"}
                        </p>
                        <p class="max-w-md text-body-md text-on-surface-variant">
                          {social.description || "Visit our Instagram page for the latest travel moments and underwater highlights."}
                        </p>
                      </div>
                    </blockquote>
                  </div>
                ) : (
                  <div class="border-y border-outline-variant/50 py-6">
                    <p class="text-body-md text-on-surface-variant">
                      {social.description || "Visit this channel for the latest updates from Undersea Expeditions."}
                    </p>
                  </div>
                )}
                {social.href && (
                  <a
                    class="mt-5 inline-flex items-center gap-2 font-bold text-surface-tint underline decoration-surface-tint/40 underline-offset-4 hover:text-primary"
                    href={normalizeUrl(social.href)}
                    rel="noreferrer"
                    target="_blank"
                  >
                    {social.buttonLabel || "Open Link"}<span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {hasMomentTiles && (
      <section class="mx-auto max-w-container-max px-margin-mobile pb-section-padding pt-14 md:px-margin-desktop">
        <h2 class="mb-7 text-3xl leading-10 text-primary">Latest social moments</h2>
        <div class="grid grid-cols-1 gap-8 xl:grid-cols-2">
          {pageContent.latestSocialMoments.tiles.map((tile) =>
            getSocialPlatform(tile.href) === "facebook" ? (
              <article class="overflow-hidden border-t border-outline-variant/60 pt-5">
                <div class="overflow-hidden bg-white">
                  <iframe
                    title="Facebook post"
                    src={getFacebookPostEmbedUrl(tile.href)}
                    width="500"
                    height="640"
                    class="w-full"
                    style="border:none;overflow:hidden"
                    scrolling="no"
                    frameborder="0"
                    allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                  ></iframe>
                </div>
              </article>
            ) : getSocialPlatform(tile.href) === "instagram" && getInstagramEmbedUrl(tile.href) ? (
              <article class="overflow-hidden border-t border-outline-variant/60 pt-5">
                <div class="overflow-hidden bg-white">
                  <iframe
                    title="Instagram post"
                    src={getInstagramEmbedUrl(tile.href)}
                    class="h-[720px] w-full"
                    style="border:none;overflow:hidden"
                    allowtransparency="true"
                  />
                </div>
              </article>
            ) : getSocialPlatform(tile.href) === "instagram" ? (
              <article class="overflow-hidden border-t border-outline-variant/60 pt-5">
                <div class="border border-outline-variant/40 bg-white p-6">
                  <blockquote
                    class="instagram-media mx-auto !min-w-0 !w-full !max-w-full"
                    data-instgrm-permalink={normalizeUrl(tile.href)}
                    data-instgrm-version="14"
                    style="background:#FFF;border:0;box-shadow:none;margin:0 auto;max-width:540px;padding:0;width:100%;"
                  >
                    <div class="flex min-h-[26rem] flex-col items-center justify-center border border-dashed border-outline-variant/30 bg-white px-8 py-10 text-center">
                      <p class="mb-3 font-headline-md text-headline-md text-primary">
                        {getInstagramHandle(tile.href)
                          ? `@${getInstagramHandle(tile.href)}`
                          : "Instagram Post"}
                      </p>
                    </div>
                  </blockquote>
                </div>
              </article>
            ) : getSocialPlatform(tile.href) === "tiktok" && getTikTokVideoId(tile.href) ? (
              <article class="overflow-hidden border-t border-outline-variant/60 pt-5">
                <blockquote
                  cite={normalizeUrl(tile.href)}
                  class="tiktok-embed mx-auto"
                  data-video-id={getTikTokVideoId(tile.href)}
                  style="max-width:605px;min-width:280px;"
                >
                  <section><a href={normalizeUrl(tile.href)} rel="noreferrer" target="_blank">View on TikTok</a></section>
                </blockquote>
              </article>
            ) : getSocialPlatform(tile.href) === "youtube" && getYouTubeVideoId(tile.href) ? (
              <article class="overflow-hidden border-t border-outline-variant/60 pt-5">
                <iframe
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  class="aspect-video w-full"
                  src={`https://www.youtube-nocookie.com/embed/${getYouTubeVideoId(tile.href)}`}
                  title="YouTube video"
                ></iframe>
              </article>
            ) : null,
          )}
        </div>
      </section>
    )}
  </main>
  <Footer active="socials" />
</Layout>

<script async src="https://www.instagram.com/embed.js"></script>
<script async src="https://www.tiktok.com/embed.js"></script>
