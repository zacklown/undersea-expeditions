---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { getSocialsPageContent } from "../lib/content";

const pageContent = await getSocialsPageContent();
const hasSocialLinks = pageContent.socialLinks.length > 0;
const hasMomentTiles = pageContent.latestSocialMoments.tiles.length > 0;

function normalizeUrl(value?: string) {
  if (!value) return "";

  const trimmed = value.trim();

  if (!trimmed) return "";

  if (/^https?:\/\//i.test(trimmed)) return trimmed;

  return `https://${trimmed.replace(/^\/+/, "")}`;
}

function getSocialPlatform(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "generic";

  try {
    const hostname = new URL(normalized).hostname.replace(/^www\./, "").toLowerCase();

    if (hostname.includes("instagram.com")) return "instagram";
    if (hostname.includes("facebook.com")) return "facebook";
  } catch {
    return "generic";
  }

  return "generic";
}

function getInstagramHandle(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "";

  try {
    const { pathname } = new URL(normalized);
    const [firstSegment] = pathname.split("/").filter(Boolean);

    if (!firstSegment || ["p", "reel", "tv", "stories"].includes(firstSegment)) return "";

    return firstSegment;
  } catch {
    return "";
  }
}

function getInstagramEmbedUrl(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "";

  try {
    const url = new URL(normalized);
    const segments = url.pathname.split("/").filter(Boolean);
    const [firstSegment, secondSegment] = segments;

    if (!firstSegment) return "";

    if (["p", "reel", "tv"].includes(firstSegment) && secondSegment) {
      return `https://www.instagram.com/${firstSegment}/${secondSegment}/embed/captioned/`;
    }
  } catch {
    return "";
  }

  return "";
}

function getFacebookPageEmbedUrl(value?: string) {
  const normalized = normalizeUrl(value);

  if (!normalized) return "";

  return `https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(
    normalized,
  )}&tabs=timeline&width=500&height=720&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=false`;
}
---

<Layout title={`${pageContent.title || "Socials"} | Undersea Expeditions`}>
  <Header active="socials" />
  <main>
    <section class="py-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
      <div class="max-w-3xl">
        {pageContent.title && (
          <h1 class="font-display-lg text-display-lg text-primary mb-6">{pageContent.title}</h1>
        )}
        {pageContent.description && (
          <p class="font-body-lg text-body-lg text-on-surface-variant">{pageContent.description}</p>
        )}
      </div>
    </section>

    {hasSocialLinks && (
      <section class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="grid grid-cols-1 gap-8 xl:grid-cols-2">
          {pageContent.socialLinks.map((social) => (
            <article class="overflow-hidden rounded-[32px] border border-secondary-fixed/60 bg-white shadow-[0_24px_70px_rgba(4,44,72,0.10)]">
              <div class="border-b border-outline-variant/20 px-8 py-6">
                {social.eyebrow && (
                  <p class="mb-2 font-label-sm text-label-sm uppercase tracking-[0.18em] text-on-tertiary-container">
                    {social.eyebrow}
                  </p>
                )}
                <h2 class="font-headline-md text-headline-md text-primary">{social.title}</h2>
                {social.description && (
                  <p class="mt-3 text-body-md text-on-surface-variant">{social.description}</p>
                )}
              </div>
              <div class="px-8 py-7">
                {getSocialPlatform(social.href) === "facebook" && social.href ? (
                  <div class="overflow-hidden rounded-3xl border border-outline-variant/20 bg-surface-container-low">
                    <iframe
                      title={social.title}
                      src={getFacebookPageEmbedUrl(social.href)}
                      width="500"
                      height="720"
                      class="h-[720px] w-full"
                      style="border:none;overflow:hidden"
                      allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                    />
                  </div>
                ) : getSocialPlatform(social.href) === "instagram" && getInstagramEmbedUrl(social.href) ? (
                  <div class="overflow-hidden rounded-3xl border border-outline-variant/20 bg-surface-container-low">
                    <iframe
                      title={social.title}
                      src={getInstagramEmbedUrl(social.href)}
                      class="h-[720px] w-full"
                      style="border:none;overflow:hidden"
                      allowtransparency="true"
                    />
                  </div>
                ) : getSocialPlatform(social.href) === "instagram" ? (
                  <div class="rounded-3xl border border-outline-variant/20 bg-surface-container-low p-6">
                    <blockquote
                      class="instagram-media mx-auto !min-w-0 !w-full !max-w-full"
                      data-instgrm-permalink={normalizeUrl(social.href)}
                      data-instgrm-version="14"
                      style="background:#FFF;border:0;border-radius:24px;box-shadow:none;margin:0 auto;max-width:540px;padding:0;width:100%;"
                    >
                      <div class="flex min-h-[26rem] flex-col items-center justify-center rounded-[20px] border border-dashed border-outline-variant/30 bg-white px-8 py-10 text-center">
                        <p class="mb-3 font-headline-md text-headline-md text-primary">
                          {getInstagramHandle(social.href)
                            ? `@${getInstagramHandle(social.href)}`
                            : "Instagram Profile"}
                        </p>
                        <p class="max-w-md text-body-md text-on-surface-variant">
                          {social.description || "Visit our Instagram page for the latest travel moments and underwater highlights."}
                        </p>
                      </div>
                    </blockquote>
                  </div>
                ) : (
                  <div class="rounded-3xl border border-outline-variant/20 bg-surface-container-low p-8">
                    <p class="text-body-md text-on-surface-variant">
                      {social.description || "Visit this channel for the latest updates from Undersea Expeditions."}
                    </p>
                  </div>
                )}
                {social.href && (
                  <a
                    class="mt-5 inline-flex items-center justify-center rounded-full bg-on-tertiary-container px-6 py-3 font-bold text-white transition-opacity hover:opacity-90"
                    href={normalizeUrl(social.href)}
                    rel="noreferrer"
                    target="_blank"
                  >
                    {social.buttonLabel || "Open Link"}
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {hasMomentTiles && (
      <section class="pb-section-padding pt-14 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="mb-8 max-w-2xl">
          {pageContent.latestSocialMoments.title && (
            <h2 class="font-headline-lg text-headline-lg text-primary">
              {pageContent.latestSocialMoments.title}
            </h2>
          )}
          {pageContent.latestSocialMoments.description && (
            <p class="mt-3 text-body-lg text-on-surface-variant">
              {pageContent.latestSocialMoments.description}
            </p>
          )}
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
          {pageContent.latestSocialMoments.tiles.map((tile) =>
            tile.href ? (
              <a class="group block cursor-pointer" href={tile.href} rel="noreferrer" target="_blank">
                <article class="overflow-hidden rounded-3xl bg-white border border-secondary-fixed shadow-sm transition-shadow hover:shadow-xl">
                  {tile.image?.url && (
                    <div class="relative aspect-[4/3] overflow-hidden">
                      <img
                        alt={tile.image.alt || tile.title}
                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                        src={tile.image.url}
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent"></div>
                      <div class="absolute inset-x-0 bottom-0 p-6">
                        {tile.eyebrow && (
                          <p class="text-white/75 text-label-sm uppercase tracking-[0.18em] mb-2">
                            {tile.eyebrow}
                          </p>
                        )}
                        <h2 class="font-headline-md text-headline-md text-white">{tile.title}</h2>
                      </div>
                    </div>
                  )}
                  <div class="p-6">
                    {!tile.image?.url && tile.eyebrow && (
                      <p class="mb-2 text-label-sm uppercase tracking-[0.18em] text-on-tertiary-container">
                        {tile.eyebrow}
                      </p>
                    )}
                    {!tile.image?.url && (
                      <h2 class="font-headline-md text-headline-md text-primary">{tile.title}</h2>
                    )}
                    {tile.description && (
                      <p class:list={["text-body-md text-on-surface-variant", !tile.image?.url ? "mt-3" : ""]}>
                        {tile.description}
                      </p>
                    )}
                    <span class="mt-5 inline-flex items-center font-bold text-on-tertiary-container">
                      {tile.buttonLabel || "Open Link"}
                    </span>
                  </div>
                </article>
              </a>
            ) : (
              <div class="group block">
                <article class="overflow-hidden rounded-3xl bg-white border border-secondary-fixed shadow-sm">
                  {tile.image?.url && (
                    <div class="relative aspect-[4/3] overflow-hidden">
                      <img
                        alt={tile.image.alt || tile.title}
                        class="h-full w-full object-cover"
                        src={tile.image.url}
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent"></div>
                      <div class="absolute inset-x-0 bottom-0 p-6">
                        {tile.eyebrow && (
                          <p class="text-white/75 text-label-sm uppercase tracking-[0.18em] mb-2">
                            {tile.eyebrow}
                          </p>
                        )}
                        <h2 class="font-headline-md text-headline-md text-white">{tile.title}</h2>
                      </div>
                    </div>
                  )}
                  <div class="p-6">
                    {!tile.image?.url && tile.eyebrow && (
                      <p class="mb-2 text-label-sm uppercase tracking-[0.18em] text-on-tertiary-container">
                        {tile.eyebrow}
                      </p>
                    )}
                    {!tile.image?.url && (
                      <h2 class="font-headline-md text-headline-md text-primary">{tile.title}</h2>
                    )}
                    {tile.description && (
                      <p class:list={["text-body-md text-on-surface-variant", !tile.image?.url ? "mt-3" : ""]}>
                        {tile.description}
                      </p>
                    )}
                  </div>
                </article>
              </div>
            ),
          )}
        </div>
      </section>
    )}
  </main>
  <Footer active="socials" />
</Layout>

<script async src="https://www.instagram.com/embed.js"></script>
