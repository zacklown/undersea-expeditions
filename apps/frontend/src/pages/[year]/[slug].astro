---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import { getSiteSettings, getTripByYearAndSlug, getTrips } from "../../lib/content";

export async function getStaticPaths() {
  const trips = await getTrips();

  return trips.map((trip) => ({
    params: {
      slug: trip.slug,
      year: String(trip.tripYear),
    },
  }));
}

const { slug, year } = Astro.params;
const trips = await getTrips();
const trip = slug && year ? await getTripByYearAndSlug(year, slug) : null;
const siteSettings = await getSiteSettings();
const otherTrips = trips.filter((item) => item.path !== trip?.path);
const featuredTrips = otherTrips.filter((item) => item.featuredOnHomepage).slice(0, 4);
const upcomingTrips = otherTrips.filter((item) => !item.featuredOnHomepage).slice(0, 6);
const stayIcon = trip?.tripStyle === "liveaboard" ? "directions_boat" : "hotel";
const stayLabel = trip?.stays?.join(", ") || "";
const tripHighlights = [
  { icon: "explore", label: "Destination", value: trip?.countries.join(", ") },
  { icon: stayIcon, label: "Your stay", value: stayLabel || trip?.tripStyleLabel },
  {
    icon: "schedule",
    label: "Time away",
    value: trip?.days ? [`${trip.days} days`, trip.nights != null ? `${trip.nights} nights` : ""].filter(Boolean).join(" / ") : trip?.dateLabel,
  },
].filter((highlight) => highlight.value);
const insuranceImage = trip?.insuranceImage || siteSettings.insurance.defaultImage || trip?.coverImage;
type TripSocialEmbed = NonNullable<NonNullable<typeof trip>["socialEmbeds"]>[number];
type SocialEmbed = TripSocialEmbed & { embedUrl: string };

function normalizeSocialUrl(value: string) {
  const trimmed = value.trim();
  if (!trimmed) return null;

  try {
    return new URL(/^https?:\/\//i.test(trimmed) ? trimmed : `https://${trimmed.replace(/^\/+/, "")}`);
  } catch {
    return null;
  }
}

function createSocialEmbed(embed: TripSocialEmbed): SocialEmbed | null {
  const url = normalizeSocialUrl(embed.postUrl);
  if (!url) return null;

  const hostname = url.hostname.replace(/^(www\.|m\.)/, "").toLowerCase();

  if (embed.platform === "instagram" && hostname === "instagram.com") {
    const [kind, id] = url.pathname.split("/").filter(Boolean);
    if (!["p", "reel", "tv"].includes(kind || "") || !id) return null;

    return {
      ...embed,
      postUrl: url.href,
      embedUrl: `https://www.instagram.com/${kind}/${id}/embed/captioned/`,
    };
  }

  if (embed.platform === "facebook" && ["facebook.com", "fb.com"].includes(hostname)) {
    return {
      ...embed,
      postUrl: url.href,
      embedUrl: `https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(url.href)}&show_text=true&width=500`,
    };
  }

  return null;
}

const socialEmbeds: SocialEmbed[] = trip?.socialEmbeds?.flatMap((embed) => {
  const normalized = createSocialEmbed(embed);
  return normalized ? [normalized] : [];
}) || [];
---

<Layout title={`${trip?.title || "Trip"} | Undersea Expeditions`}>
  <Header active="trips" />
  <main>
    {trip ? (
      <>
        <section class="mx-auto max-w-[1520px] px-margin-mobile pt-8 pb-section-padding md:px-margin-desktop md:pt-10">
          <div class="grid grid-cols-1 gap-8 xl:grid-cols-[13rem_minmax(0,1fr)_16rem]">
            <aside class="order-2 xl:order-none xl:self-start">
              <div class="space-y-6">
                {featuredTrips.length > 0 && (
                  <div class="border-t-2 border-primary pt-5">
                    <h2 class="mb-5 text-xl text-primary">Featured Trips</h2>
                    <div class="divide-y divide-outline-variant/60">
                      {featuredTrips.map((item) => (
                        <a class="block py-4 first:pt-0 last:pb-0 transition-colors hover:text-surface-tint" href={item.path}>
                          <p class="font-bold text-primary">{item.title}</p>
                          <p class="mt-1 text-sm text-on-surface-variant">
                            {item.countries.join(", ")}
                          </p>
                          <p class="mt-1 text-sm text-on-surface-variant">{item.dateLabel}</p>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {upcomingTrips.length > 0 && (
                  <div class="border-t border-outline-variant/70 pt-5">
                    <h2 class="mb-5 text-xl text-primary">Upcoming Trips</h2>
                    <div class="space-y-4">
                      {upcomingTrips.map((item) => (
                        <a class="block transition-opacity hover:opacity-80" href={item.path}>
                          <p class="font-bold text-primary">{item.title}</p>
                          <p class="mt-1 text-sm text-on-surface-variant">{item.dateLabel}</p>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </aside>

            <div class="order-1 min-w-0 space-y-8 xl:order-none">
              <article>
                <header class="mb-8">
                  <div class="mb-4 flex flex-wrap items-center gap-3 text-label-sm font-label-sm">
                    <span class="rounded-full bg-primary/10 px-4 py-1 text-primary">{trip.regionLabel}</span>
                    {trip.isNew && <span class="rounded-full bg-on-tertiary-container px-4 py-1 text-white">New</span>}
                    {trip.statusLabel && <span class="rounded-full bg-primary px-4 py-1 text-white">{trip.statusLabel}</span>}
                  </div>
                  <h1 class="mb-3 font-headline-lg text-headline-lg-mobile text-primary md:text-headline-lg">{trip.title}</h1>
                  <p class="flex items-center gap-2 font-body-lg text-body-lg text-on-surface-variant">
                    <span aria-hidden="true" class="material-symbols-outlined text-surface-tint">calendar_today</span>
                    {trip.dateLabel}
                  </p>
                </header>
                <section class="mb-10" aria-label="Trip introduction">
                  <figure class="mb-6 overflow-hidden rounded-xl bg-primary-fixed">
                    <img
                      alt={trip.coverImage.alt || trip.title}
                      class="aspect-[4/3] w-full object-cover sm:aspect-[16/10]"
                      fetchpriority="high"
                      src={trip.coverImage.url}
                    />
                  </figure>

                  {tripHighlights.length > 0 && (
                    <dl class="mb-8 grid w-full grid-cols-1 divide-y divide-primary/10 py-2 sm:grid-cols-[repeat(var(--trip-highlight-count),minmax(0,1fr))] sm:divide-x sm:divide-y-0 sm:py-5" style={`--trip-highlight-count: ${tripHighlights.length}`}>
                      {tripHighlights.map((highlight) => (
                        <div class="min-w-0 py-4 sm:px-5 sm:py-0 sm:first:pl-0 sm:last:pr-0">
                          <dt class="sr-only">{highlight.label}</dt>
                          <dd class="flex items-center justify-center gap-3 text-center text-sm font-medium leading-6 text-primary">
                            <span aria-hidden="true" class="material-symbols-outlined shrink-0 text-2xl text-surface-tint">{highlight.icon}</span>
                            <span class="min-w-0 break-words">{highlight.value}</span>
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )}

                  {trip.overview && (
                    <div
                      class="text-on-surface-variant [&>p]:mb-4 [&>p]:font-body-md [&>p]:text-body-md [&>p:first-child]:text-lg [&>p:first-child]:leading-8 [&>p:first-child]:text-primary [&_a]:text-on-tertiary-container [&_a]:underline [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
                      set:html={trip.overview}
                    ></div>
                  )}
                </section>

                {trip.gallery && trip.gallery.length > 0 && (
                  <section class="mb-10 border-t border-outline-variant/60 pt-8" aria-labelledby="gallery-title">
                    <div class="mb-6">
                      <h2 id="gallery-title" class="font-headline-md text-headline-md text-primary">Boat &amp; Rooms</h2>
                    </div>
                    <div class="relative" data-trip-gallery>
                      <div
                        aria-label={`${trip.title} photo gallery`}
                        class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
                        data-gallery-viewport
                        tabindex="0"
                      >
                      {trip.gallery.map((item, index) => (
                        <figure class="group relative min-w-full snap-center overflow-hidden bg-primary" data-gallery-slide>
                          <img
                            alt={item.image.alt || item.description || `${trip.title} accommodation`}
                            class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-[1.015] sm:h-96 md:h-[30rem]"
                            loading="lazy"
                            src={item.image.url}
                          />
                          <figcaption class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-4 border-t border-white/15 bg-primary/90 px-5 py-3 text-sm leading-5 text-white backdrop-blur-md">
                            <span>{item.description || "Trip gallery"}</span>
                            <span class="shrink-0 text-white/70">{index + 1} / {trip.gallery!.length}</span>
                          </figcaption>
                        </figure>
                      ))}
                      </div>
                      {trip.gallery.length > 1 && (
                        <>
                          <button
                            aria-label="Previous gallery photo"
                            class="absolute left-3 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-primary/75 text-white shadow-lg backdrop-blur-md transition hover:bg-primary disabled:cursor-default disabled:opacity-35 sm:left-4"
                            data-gallery-previous
                            type="button"
                          >
                            <span aria-hidden="true" class="material-symbols-outlined">chevron_left</span>
                          </button>
                          <button
                            aria-label="Next gallery photo"
                            class="absolute right-3 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-primary/75 text-white shadow-lg backdrop-blur-md transition hover:bg-primary disabled:cursor-default disabled:opacity-35 sm:right-4"
                            data-gallery-next
                            type="button"
                          >
                            <span aria-hidden="true" class="material-symbols-outlined">chevron_right</span>
                          </button>
                        </>
                      )}
                    </div>
                  </section>
                )}

                <div class="space-y-6 leading-relaxed text-on-surface-variant">
                  {trip.packageIncludes && (
                    <section class="rounded-xl border border-primary/10 bg-primary-fixed/40 p-6 sm:p-8">
                      <h2 class="mb-4 font-headline-md text-headline-md text-primary">
                        Our Package Includes
                      </h2>
                      <div
                        class="[&>p]:mb-4 [&>p]:font-body-md [&>p]:text-body-md [&_a]:text-on-tertiary-container [&_a]:underline [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
                        set:html={trip.packageIncludes}
                      ></div>
                    </section>
                  )}
                  {trip.notIncluded && (
                    <section class="border-t border-outline-variant/60 pt-7">
                      <h2 class="mb-4 font-headline-md text-headline-md text-primary">Not Included</h2>
                      <div
                        class="[&>p]:mb-4 [&>p]:font-body-md [&>p]:text-body-md [&_a]:text-on-tertiary-container [&_a]:underline [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
                        set:html={trip.notIncluded}
                      ></div>
                    </section>
                  )}
                  {trip.flights && (
                    <section class="border-t border-outline-variant/60 pt-7">
                      <h2 class="mb-4 font-headline-md text-headline-md text-primary">Flights</h2>
                      <div
                        class="[&>p]:mb-4 [&>p]:font-body-md [&>p]:text-body-md [&_a]:text-on-tertiary-container [&_a]:underline [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
                        set:html={trip.flights}
                      ></div>
                    </section>
                  )}
                  {trip.deposit && (
                    <section class="rounded-xl border border-primary/10 bg-primary-fixed/40 p-6 sm:p-8">
                      <h2 class="mb-4 font-headline-md text-headline-md text-primary">Deposit</h2>
                      <div
                        class="[&>p]:mb-4 [&>p]:font-body-md [&>p]:text-body-md [&_a]:text-on-tertiary-container [&_a]:underline [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
                        set:html={trip.deposit}
                      ></div>
                      <div class="mt-6 flex justify-center">
                        <a
                          class="inline-flex items-center justify-center rounded-full bg-on-tertiary-container px-8 py-3 text-center font-bold text-white transition-opacity hover:opacity-90"
                          href={trip.bookingHref || "/contact"}
                        >
                          {trip.bookingLabel || "Contact Us"}
                        </a>
                      </div>
                    </section>
                  )}
                </div>
              </article>

              {socialEmbeds.length > 0 && (
                <section class="border-t border-outline-variant/60 pt-8">
                  <div class="mb-6 max-w-2xl">
                    <h2 class="font-headline-md text-headline-md text-primary">See this trip on social</h2>
                  </div>
                  <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
                    {socialEmbeds.map((embed) => (
                      <article class="overflow-hidden border-t border-outline-variant/60 pt-4">
                        <div class="mb-4 flex items-center justify-between gap-4">
                          <div>
                            <p class="font-label-sm text-label-sm uppercase tracking-[0.16em] text-on-tertiary-container">
                              {embed.platform}
                            </p>
                            {embed.title && (
                              <h3 class="mt-1 font-bold text-primary">{embed.title}</h3>
                            )}
                          </div>
                          <a
                            class="text-sm font-bold text-on-tertiary-container hover:underline"
                            href={embed.postUrl}
                            rel="noreferrer"
                            target="_blank"
                          >
                            Open Post
                          </a>
                        </div>
                        <div class="overflow-hidden border border-outline-variant/40 bg-white">
                          <iframe
                            title={embed.title || `${embed.platform} post`}
                            src={embed.embedUrl}
                            class="w-full"
                            height={embed.platform === "facebook" ? "640" : "720"}
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            style="border:0; overflow:hidden;"
                            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                          ></iframe>
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              )}
            </div>

            <aside class="order-3 xl:order-none xl:self-start">
              <div class="space-y-6">
                <div class="border-t-2 border-primary pt-5">
                  <h2 class="mb-4 font-headline-md text-headline-md text-primary">Contact Us</h2>
                  <p class="mb-8 text-body-md text-on-surface-variant">
                    Reach out for cabins, experience requirements, pricing, and itinerary fit.
                  </p>
                  {trip.pricingOptions && trip.pricingOptions.length > 0 && (
                    <div class="mb-8 space-y-4">
                      {trip.pricingOptions.map((price) => (
                        <div class="border-b border-outline-variant/60 pb-4">
                          <p class="font-bold text-primary">{price.label}</p>
                          <p class="text-on-tertiary-container">${price.amount}</p>
                          {price.note && (
                            <div
                              class="mt-1 text-sm text-on-surface-variant [&_a]:text-on-tertiary-container [&_a]:underline"
                              set:html={price.note}
                            ></div>
                          )}
                        </div>
                      ))}
                    </div>
                  )}
                  <a
                    class="block w-full rounded-full bg-on-tertiary-container px-6 py-4 text-center font-bold text-white transition-opacity hover:opacity-90"
                    href={trip.bookingHref}
                  >
                    {trip.bookingLabel || "Contact Us"}
                  </a>
                </div>

                <div class="border-t border-outline-variant/70 pt-6">
                  {insuranceImage && siteSettings.insurance.links.length === 0 && (
                    <img
                      alt={insuranceImage.alt || "Travel insurance"}
                      class="mb-5 h-auto w-full object-contain"
                      src={insuranceImage.url}
                    />
                  )}
                  {siteSettings.insurance.description && (
                    <p class="mb-5 text-sm leading-6 text-on-surface-variant">{siteSettings.insurance.description}</p>
                  )}
                  {siteSettings.insurance.links.length > 0 && (
                    <div class="grid gap-3">
                      {siteSettings.insurance.links.map((link) => (
                        <div class="space-y-4">
                        {link.provider !== "dan" && insuranceImage && (
                          <img alt={insuranceImage.alt || "Travel insurance"} class="h-auto w-full object-contain" src={insuranceImage.url} />
                        )}
                        {link.provider === "dan" && (
                          <div class="w-full bg-white">
                            {siteSettings.insurance.danImage ? (
                              <img alt={siteSettings.insurance.danImage.alt || "DAN Insurance"} class="h-auto w-full object-contain" src={siteSettings.insurance.danImage.url} />
                            ) : (
                              <div class="flex aspect-[2/1] items-center justify-center text-3xl font-bold text-primary">DAN</div>
                            )}
                          </div>
                        )}
                        <a
                          class="block w-full rounded-full bg-primary px-5 py-3 text-center font-bold text-white transition-colors hover:bg-primary-container"
                          href={link.href}
                          rel="noreferrer"
                          target="_blank"
                        >
                          {link.label}
                        </a>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </aside>
          </div>
        </section>
      </>
    ) : (
      <section class="mx-auto max-w-container-max px-margin-mobile py-24 md:px-margin-desktop">
        <h1 class="mb-4 font-display-lg text-display-lg text-primary">Trip not found</h1>
        <a class="font-bold text-on-tertiary-container hover:underline" href="/trips">
          Back to all trips
        </a>
      </section>
    )}
  </main>
  <Footer active="trips" />
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-trip-gallery]").forEach((gallery) => {
    const viewport = gallery.querySelector<HTMLElement>("[data-gallery-viewport]");
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
    const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-previous]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");

    if (!viewport || slides.length < 2 || !previous || !next) return;

    let activeIndex = 0;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const goTo = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      viewport.scrollTo({
        behavior: reducedMotion.matches ? "auto" : "smooth",
        left: activeIndex * viewport.clientWidth,
      });
    };

    previous.addEventListener("click", () => goTo(activeIndex - 1));
    next.addEventListener("click", () => goTo(activeIndex + 1));
    viewport.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(activeIndex - 1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(activeIndex + 1);
      }
    });
    viewport.addEventListener(
      "scroll",
      () => {
        const nextIndex = Math.round(viewport.scrollLeft / viewport.clientWidth);
        if (nextIndex !== activeIndex) {
          activeIndex = nextIndex;
        }
      },
      { passive: true },
    );
    let touchStartX = 0;
    let touchStartIndex = 0;
    viewport.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX || 0;
        touchStartIndex = activeIndex;
      },
      { passive: true },
    );
    viewport.addEventListener(
      "touchend",
      (event) => {
        const touchEndX = event.changedTouches[0]?.clientX || 0;
        const distance = touchStartX - touchEndX;

        if (Math.abs(distance) > 50) {
          goTo(touchStartIndex + (distance > 0 ? 1 : -1));
        }
      },
      { passive: true },
    );
    window.addEventListener("resize", () => goTo(activeIndex));
  });
</script>
