---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import {
  getContactPageContent,
  getFAQPageContent,
  getSiteSettings,
  getTrips,
} from "../lib/content";

const [contactPage, faqPage, siteSettings, trips] = await Promise.all([
  getContactPageContent(),
  getFAQPageContent(),
  getSiteSettings(),
  getTrips(),
]);
---

<Layout title="Contact Us - Undersea Expeditions">
  <Header active="contact" />
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pt-12">
    <header class="mb-section-padding text-center">
      <h1 class="font-display-lg text-display-lg text-primary mb-4">{contactPage.title}</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        {contactPage.intro}
      </p>
    </header>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
      <aside class="lg:col-span-5 space-y-8">
        <div class="bg-secondary-container rounded-xl p-8 shadow-sm">
          <h2 class="font-headline-md text-headline-md text-on-secondary-fixed mb-6">Connect With Us</h2>
          <div class="space-y-12">
            <div class="flex items-start gap-4">
              <div class="bg-primary-container p-3 rounded-lg text-on-primary-container">
                <span class="material-symbols-outlined">call</span>
              </div>
              <div>
                <p class="font-label-sm text-label-sm text-on-secondary-fixed-variant uppercase tracking-widest mb-1">Toll-Free</p>
                <a class="font-headline-md text-headline-md text-primary hover:underline" href={`tel:${siteSettings.contact.tollFreePhone}`}>{siteSettings.contact.tollFreePhone}</a>
                {siteSettings.contact.internationalPhone && (
                  <p class="text-body-md mt-1">International: {siteSettings.contact.internationalPhone}</p>
                )}
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="bg-primary-container p-3 rounded-lg text-on-primary-container">
                <span class="material-symbols-outlined">mail</span>
              </div>
              <div>
                <p class="font-label-sm text-label-sm text-on-secondary-fixed-variant uppercase tracking-widest mb-1">Direct Inquiries</p>
                <a class="font-headline-md text-headline-md text-primary hover:underline" href={`mailto:${siteSettings.contact.email}`}>{siteSettings.contact.email}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="bg-primary-container p-3 rounded-lg text-on-primary-container">
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <div>
                <p class="font-label-sm text-label-sm text-on-secondary-fixed-variant uppercase tracking-widest mb-1">Headquarters</p>
                <address class="not-italic text-body-md text-on-secondary-fixed">
                  {siteSettings.contact.addressLines.map((line) => (
                    <>
                      {line}
                      <br />
                    </>
                  ))}
                </address>
              </div>
            </div>
          </div>
        </div>
        <div class="relative rounded-xl overflow-hidden group h-64">
          <img class="w-full h-full object-cover" src={contactPage.image.url} alt={contactPage.image.alt || contactPage.imageText} />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent flex items-end p-6">
            <p class="text-white font-headline-md text-headline-md">{contactPage.imageText}</p>
          </div>
        </div>
      </aside>

      <section class="lg:col-span-7">
        <div class="bg-surface-container-low rounded-xl p-8 md:p-12 border border-outline-variant/30">
          <h3 class="font-headline-md text-headline-md text-primary mb-8">Plan Your Expedition</h3>
          <form action="#" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label class="font-label-sm text-label-sm text-on-surface-variant ml-1" for="name">YOUR NAME</label>
                <input class="bg-secondary-fixed/30 border-outline-variant rounded-lg p-4 focus:ring-primary focus:border-primary transition-all" id="name" name="name" placeholder="John Doe" type="text" />
              </div>
              <div class="flex flex-col gap-2">
                <label class="font-label-sm text-label-sm text-on-surface-variant ml-1" for="email">EMAIL ADDRESS</label>
                <input class="bg-secondary-fixed/30 border-outline-variant rounded-lg p-4 focus:ring-primary focus:border-primary transition-all" id="email" name="email" placeholder="john@example.com" type="email" />
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <label class="font-label-sm text-label-sm text-on-surface-variant ml-1" for="trip">TRIP OF INTEREST</label>
              <select class="bg-secondary-fixed/30 border-outline-variant rounded-lg p-4 focus:ring-primary focus:border-primary transition-all appearance-none" id="trip" name="trip">
                <option disabled selected value="">Select an upcoming expedition</option>
                {trips.map((trip) => (
                  <option>{trip.title} - {trip.dateLabel}</option>
                ))}
              </select>
            </div>
            <div class="flex flex-col gap-2">
              <label class="font-label-sm text-label-sm text-on-surface-variant ml-1" for="message">MESSAGE (OPTIONAL)</label>
              <textarea class="bg-secondary-fixed/30 border-outline-variant rounded-lg p-4 focus:ring-primary focus:border-primary transition-all" id="message" name="message" placeholder="Tell us about your diving experience or questions..." rows="5"></textarea>
            </div>
            <div class="pt-4">
              <button class="w-full md:w-auto bg-on-tertiary-container text-white px-10 py-4 rounded-full font-bold text-lg hover:scale-95 hover:shadow-lg transition-all active:scale-90" type="submit">
                Send Inquiry
              </button>
              <p class="mt-4 text-xs text-on-surface-variant italic">
                {contactPage.privacyNote}
              </p>
            </div>
          </form>
        </div>
      </section>
    </div>

    <section class="mt-section-padding mb-section-padding">
      <h4 class="font-headline-md text-headline-md text-primary text-center mb-12">Common Questions</h4>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {faqPage.highlights.map((item) => (
          <div class="p-8 border border-outline-variant/30 rounded-xl hover:bg-surface-container transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-on-tertiary-container mb-4">{item.icon}</span>
            <h5 class="font-bold text-primary mb-2">{item.title}</h5>
            <p class="text-body-md text-on-surface-variant">{item.description}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer active="contact" />
</Layout>
