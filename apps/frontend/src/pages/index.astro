---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import HomeTripMap from "../components/HomeTripMap.astro";
import Layout from "../layouts/Layout.astro";
import { getHomePageContent, getSiteSettings, getTrips } from "../lib/content";

const [homePage, siteSettings, trips] = await Promise.all([
  getHomePageContent(),
  getSiteSettings(),
  getTrips(),
]);
const featuredTrip = trips[0];
const upcomingTrips = trips.slice(0, 3);
---

<Layout title="Undersea Expeditions | LGBTQ+ Scuba Dive Travel Experts">
  <Header active="home" />
  <main>
    <section class="relative h-[819px] flex items-center overflow-hidden">
      <img alt={homePage.hero.image.alt || homePage.hero.title} class="absolute inset-0 w-full h-full object-cover" src={homePage.hero.image.url} />
      <div class="absolute inset-0 bg-gradient-to-r from-primary/60 to-transparent"></div>
      <div class="relative z-10 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
        <div class="max-w-2xl">
          <h1 class="font-display-lg text-display-lg text-white mb-6">{homePage.hero.title}</h1>
          <p class="font-body-lg text-body-lg text-white/90 mb-8 max-w-lg">{homePage.hero.description}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a class="bg-[#C5A059] text-white px-8 py-4 rounded-lg font-bold shadow-lg hover:bg-on-tertiary-container transition-colors text-center" href={homePage.hero.primaryCtaHref}>{homePage.hero.primaryCtaLabel}</a>
            <a class="bg-white/10 backdrop-blur-md border border-white text-white px-8 py-4 rounded-lg font-bold hover:bg-white/20 transition-colors text-center" href={homePage.hero.secondaryCtaHref}>{homePage.hero.secondaryCtaLabel}</a>
          </div>
        </div>
      </div>
    </section>

    <HomeTripMap trips={trips} />

    <section class="py-section-padding px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter items-center bg-secondary-container rounded-3xl overflow-hidden shadow-2xl">
        <div class="p-12 md:p-16">
          <div class="inline-block bg-on-tertiary-container text-white px-4 py-1 rounded-full text-label-sm font-label-sm mb-6">{homePage.featuredIntro.eyebrow}</div>
          <h2 class="font-headline-lg text-headline-lg text-primary mb-4">{featuredTrip.title}</h2>
          <p class="font-headline-md text-headline-md text-on-tertiary-container mb-6">{featuredTrip.countries.join(", ")}</p>
          <div class="flex items-center gap-3 text-primary mb-8">
            <span class="material-symbols-outlined">calendar_today</span>
            <span class="font-bold">{featuredTrip.dateLabel}</span>
          </div>
          <p class="font-body-lg text-body-lg text-secondary mb-10 leading-relaxed">
            {featuredTrip.summary}
          </p>
          <a class="inline-block border-2 border-primary text-primary px-8 py-3 rounded-lg font-bold hover:bg-primary hover:text-white transition-all font-headline-md" href={featuredTrip.path}>{featuredTrip.bookingLabel}</a>
        </div>
        <div class="h-full min-h-[400px] relative">
          <img alt={featuredTrip.coverImage.alt || featuredTrip.title} class="absolute inset-0 w-full h-full object-cover" src={featuredTrip.coverImage.url} />
        </div>
      </div>
    </section>

    <section class="py-section-padding bg-surface-container-low">
      <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
          <div>
            <h2 class="font-headline-lg text-headline-lg text-primary">{homePage.tripsIntro.title}</h2>
            <p class="font-body-lg text-body-lg text-secondary mt-2">{homePage.tripsIntro.description}</p>
          </div>
          <a class="text-on-tertiary-container font-bold flex items-center gap-2 hover:underline" href="/trips">
            View All Trips <span class="material-symbols-outlined">arrow_forward</span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {upcomingTrips.map((trip) => (
            <article class="group relative bg-white rounded-2xl overflow-hidden border border-secondary-fixed shadow-sm hover:shadow-xl transition-shadow">
              <div class="aspect-[4/3] relative overflow-hidden">
                <img alt={trip.coverImage.alt || trip.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src={trip.coverImage.url} />
                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded text-label-sm font-label-sm text-primary">{trip.regionLabel}</div>
                {trip.isNew && (
                  <div class="absolute top-4 right-4 bg-[#C5A059] px-3 py-1 rounded text-label-sm font-label-sm text-white">New</div>
                )}
              </div>
              <div class="p-6">
                <h3 class="font-headline-md text-headline-md text-primary mb-2">{trip.title}</h3>
                <p class="text-on-tertiary-container font-bold mb-4">{trip.dateLabel}</p>
                <p class="font-body-md text-body-md text-secondary mb-6">{trip.summary}</p>
                <a class="block w-full py-3 rounded-lg border border-primary text-primary font-bold group-hover:bg-primary group-hover:text-white transition-all text-center" href={trip.path}>Details &amp; Booking</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-section-padding px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto overflow-hidden">
      <div class="flex flex-col md:flex-row items-center gap-16">
        <div class="w-full md:w-1/2 relative">
          <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl">
            <img alt={homePage.story.image.alt || homePage.story.title} class="w-full aspect-square object-cover" src={homePage.story.image.url} />
          </div>
          <div class="absolute -bottom-8 -right-8 w-64 h-64 bg-secondary-container rounded-full -z-10"></div>
          <div class="absolute -top-8 -left-8 w-32 h-32 border-4 border-on-tertiary-container rounded-lg -z-10"></div>
        </div>
        <div class="w-full md:w-1/2">
          <h2 class="font-headline-lg text-headline-lg text-primary mb-6">{homePage.story.title}</h2>
          {homePage.story.body.map((paragraph, index) => (
            <p class:list={["font-body-lg text-body-lg text-secondary leading-relaxed", index === 0 ? "mb-6" : "mb-8"]}>{paragraph}</p>
          ))}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-on-tertiary-container text-3xl">diversity_3</span>
              <div>
                <h4 class="font-bold text-primary">{homePage.story.statOneTitle}</h4>
                <p class="text-label-sm font-label-sm text-secondary">{homePage.story.statOneBody}</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-on-tertiary-container text-3xl">travel_explore</span>
              <div>
                <h4 class="font-bold text-primary">{homePage.story.statTwoTitle}</h4>
                <p class="text-label-sm font-label-sm text-secondary">{homePage.story.statTwoBody}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-section-padding bg-primary text-white text-center">
      <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <h2 class="font-headline-lg text-headline-lg mb-8 text-white">Ready to Dive In?</h2>
        <p class="font-body-lg text-body-lg mb-12 opacity-90 max-w-2xl mx-auto">{homePage.cta.description}</p>
        <div class="flex flex-col md:flex-row justify-center items-center gap-12 mb-16">
          <div class="flex flex-col items-center">
            <span class="material-symbols-outlined text-4xl mb-4 text-[#C5A059]">call</span>
            <p class="text-label-sm font-label-sm opacity-70 mb-1">{homePage.cta.phoneLabel}</p>
            <a class="font-headline-md text-headline-md hover:text-[#C5A059] transition-colors" href={`tel:${siteSettings.contact.tollFreePhone}`}>{siteSettings.contact.tollFreePhone}</a>
          </div>
          <div class="w-px h-24 bg-white/20 hidden md:block"></div>
          <div class="flex flex-col items-center">
            <span class="material-symbols-outlined text-4xl mb-4 text-[#C5A059]">mail</span>
            <p class="text-label-sm font-label-sm opacity-70 mb-1">{homePage.cta.emailLabel}</p>
            <a class="font-headline-md text-headline-md hover:text-[#C5A059] transition-colors" href={`mailto:${siteSettings.contact.email}`}>{siteSettings.contact.email}</a>
          </div>
        </div>
        <div class="glass-card p-8 rounded-2xl max-w-3xl mx-auto inline-block border border-white/20">
          <p class="font-body-md text-primary mb-4 font-bold">{homePage.cta.title}</p>
          <form class="flex flex-col md:flex-row gap-4">
            <input class="bg-surface border-none rounded-lg px-6 py-3 text-primary flex-grow focus:ring-2 focus:ring-[#C5A059]" placeholder={homePage.cta.newsletterPlaceholder} type="email" />
            <button class="bg-primary text-white px-8 py-3 rounded-lg font-bold hover:bg-on-primary-fixed transition-all" type="submit">{homePage.cta.newsletterButtonLabel}</button>
          </form>
          <p class="text-xs text-secondary mt-4">{homePage.cta.newsletterHelperText}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer active="home" />
</Layout>
