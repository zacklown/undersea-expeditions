---
import FeaturedTripsCarousel from "../components/FeaturedTripsCarousel.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import HomeTripMap from "../components/HomeTripMap.astro";
import Layout from "../layouts/Layout.astro";
import heroVideo from "../assets/Dolphin-1080p (1).mp4";
import { getHomePageContent, getSiteSettings, getTrips } from "../lib/content";

const [homePage, siteSettings, trips] = await Promise.all([
  getHomePageContent(),
  getSiteSettings(),
  getTrips(),
]);
const listedTrips = trips.filter((trip) => trip.showInListings !== false);
const featuredTrips = listedTrips.filter((trip) => trip.featuredOnHomepage);
const homepageFeaturedTrips = (featuredTrips.length > 0 ? featuredTrips : listedTrips).slice(0, Math.max(featuredTrips.length, 3));
---

<Layout title="Undersea Expeditions | LGBTQ+ Scuba Dive Travel Experts">
  <Header active="home" overlayHero />
  <main>
    <section class="relative flex min-h-[720px] items-end overflow-hidden pb-36 pt-40 md:min-h-[780px] md:pb-44 md:pt-48" data-hero-media>
      <video
        aria-hidden="true"
        autoplay
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 motion-reduce:hidden"
        data-hero-video
        loop
        muted
        playsinline
        preload="auto"
        src={heroVideo}
      ></video>
      <img
        alt={homePage.hero.image.alt || homePage.hero.title}
        class="absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-1000"
        data-hero-image
        src={homePage.hero.image.url}
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(90deg, rgba(3, 38, 64, 0.9) 0%, rgba(4, 59, 92, 0.64) 35%, rgba(4, 59, 92, 0.2) 62%, transparent 84%);"
      ></div>
      <div class="relative z-10 mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop">
        <div class="max-w-[44rem] md:-ml-3">
          <h1 class="mb-7 font-display-lg text-[clamp(4rem,7vw,5.5rem)] font-medium leading-[0.98] tracking-[-0.035em] text-white drop-shadow-sm md:mb-9">
            Undersea Expeditions
          </h1>
          {homePage.hero.description && (
            <p class="mb-9 max-w-[31rem] font-body-lg text-[17px] leading-7 text-white/85 md:mb-11 md:text-lg">{homePage.hero.description}</p>
          )}
          <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
            <a
              class="inline-flex items-center justify-center rounded-lg border border-white/55 bg-white/5 px-5 py-3 text-[15px] font-bold text-white backdrop-blur-sm transition-colors hover:border-white/80 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
              href="/socials"
            >
              View Socials
            </a>
            <a
              class="inline-flex items-center justify-center rounded-lg bg-on-tertiary-container px-6 py-3.5 text-[15px] font-bold text-white shadow-md shadow-black/15 transition-all hover:-translate-y-0.5 hover:bg-tertiary-fixed-dim hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
              href={homePage.hero.primaryCtaHref}
            >
              Book Your Trip
              <span aria-hidden="true" class="ml-2 text-lg leading-none">→</span>
            </a>
          </div>
        </div>
      </div>
      <svg
        aria-hidden="true"
        class="wave-drift pointer-events-none absolute -bottom-px left-0 z-20 h-14 w-full md:h-20"
        preserveAspectRatio="none"
        viewBox="0 0 1440 96"
      >
        <path
          d="M0 64C188 95 352 90 540 54C758 12 928 11 1114 54C1244 84 1344 82 1440 58V96H0Z"
          fill="#f4f3f8"
        />
      </svg>
    </section>

    <FeaturedTripsCarousel
      description={homePage.featuredTrips.description}
      title={homePage.featuredTrips.title}
      trips={homepageFeaturedTrips}
    />

    <HomeTripMap
      buttonHref={homePage.mapSection.buttonHref}
      buttonLabel="See More Trips"
      description={homePage.mapSection.description}
      title={homePage.mapSection.title}
      trips={listedTrips}
    />

    <section class="mx-auto max-w-container-max overflow-hidden px-margin-mobile py-24 md:px-margin-desktop md:py-28">
      <div class="flex flex-col items-center gap-10 md:flex-row md:gap-12">
        <div class="w-full md:w-1/2 relative">
          <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl">
            <img alt={homePage.story.image.alt || homePage.story.title} class="w-full aspect-square object-cover" src={homePage.story.image.url} />
          </div>
          <div class="absolute -bottom-8 -right-8 w-64 h-64 bg-secondary-container rounded-full -z-10"></div>
          <div class="absolute -top-8 -left-8 w-32 h-32 border-4 border-on-tertiary-container rounded-lg -z-10"></div>
        </div>
        <div class="w-full md:w-1/2">
          <h2 class="mb-5 font-headline-lg text-headline-lg text-primary md:mb-6">{homePage.story.title}</h2>
          {homePage.story.body.map((paragraph, index) => (
            <p class:list={["font-body-lg text-body-lg text-secondary leading-relaxed", index === 0 ? "mb-5" : "mb-6"]}>{paragraph}</p>
          ))}
          {homePage.story.buttonLabel && homePage.story.buttonHref && (
            <a
              class="inline-flex items-center justify-center rounded-lg border border-primary px-6 py-3 font-bold text-primary transition-all hover:bg-primary hover:text-white"
              href={homePage.story.buttonHref}
            >
              {homePage.story.buttonLabel}
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="relative z-10 bg-[#0066B2] py-20 text-center text-white md:py-24">
      <svg
        aria-hidden="true"
        class="wave-drift pointer-events-none absolute left-0 top-px h-14 w-full -translate-y-full md:h-20"
        preserveAspectRatio="none"
        viewBox="0 0 1440 96"
      >
        <path
          d="M0 58C166 18 330 12 520 52C734 97 920 92 1112 48C1248 17 1348 20 1440 48V96H0Z"
          fill="#0066B2"
        />
      </svg>
      <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <h2 class="mb-6 font-headline-lg text-headline-lg text-white md:mb-7">{homePage.cta.title}</h2>
        <p class="mx-auto mb-10 max-w-2xl font-body-lg text-body-lg opacity-90 md:mb-12">{homePage.cta.description}</p>
        <div class="mb-4 flex flex-col items-center justify-center gap-10 md:mb-0 md:flex-row md:gap-12">
          <div class="flex flex-col items-center">
            <span class="material-symbols-outlined text-4xl mb-4 text-on-tertiary-container">call</span>
            <p class="text-label-sm font-label-sm opacity-70 mb-1">{homePage.cta.phoneLabel}</p>
            <a class="font-headline-md text-headline-md hover:text-on-tertiary-container transition-colors" href={`tel:${siteSettings.contact.tollFreePhone}`}>{siteSettings.contact.tollFreePhone}</a>
          </div>
          <div class="w-px h-24 bg-white/20 hidden md:block"></div>
          <div class="flex flex-col items-center">
            <span class="material-symbols-outlined text-4xl mb-4 text-on-tertiary-container">mail</span>
            <p class="text-label-sm font-label-sm opacity-70 mb-1">{homePage.cta.emailLabel}</p>
            <a class="font-headline-md text-headline-md hover:text-on-tertiary-container transition-colors" href={`mailto:${siteSettings.contact.email}`}>{siteSettings.contact.email}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer active="home" flushTop />
</Layout>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero-media]");
  const video = hero?.querySelector<HTMLVideoElement>("[data-hero-video]");
  const image = hero?.querySelector<HTMLImageElement>("[data-hero-image]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (video && image && !reduceMotion) {
    const revealVideo = () => {
      video.classList.replace("opacity-0", "opacity-100");
      image.classList.replace("opacity-100", "opacity-0");
    };

    if (video.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) {
      revealVideo();
    } else {
      video.addEventListener("canplay", revealVideo, { once: true });
    }
  }
</script>
