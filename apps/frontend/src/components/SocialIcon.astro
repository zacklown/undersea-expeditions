---
interface Props {
  platform?: string;
}

const { platform = "website" } = Astro.props;
---

<svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
  {platform === "instagram" ? (
    <>
      <rect fill="none" height="17" rx="5" stroke="currentColor" stroke-width="2" width="17" x="3.5" y="3.5" />
      <circle cx="12" cy="12" fill="none" r="4" stroke="currentColor" stroke-width="2" />
      <circle cx="17.4" cy="6.7" r="1.1" />
    </>
  ) : platform === "facebook" ? (
    <path d="M13.7 21v-8h2.8l.4-3h-3.2V8.1c0-.9.3-1.5 1.6-1.5H17V3.9c-.8-.1-1.6-.2-2.4-.2-2.5 0-4.2 1.5-4.2 4.3v2H8v3h2.4v8h3.3Z" />
  ) : platform === "tiktok" ? (
    <path d="M15.2 3c.3 2.2 1.5 3.5 3.8 3.7v3.1a8.7 8.7 0 0 1-3.8-.9v5.8a6.3 6.3 0 1 1-5.4-6.2v3.2a3.2 3.2 0 1 0 2.2 3V3h3.2Z" />
  ) : platform === "youtube" ? (
    <>
      <path d="M21.5 7.1a3 3 0 0 0-2.1-2.1C17.5 4.5 12 4.5 12 4.5S6.5 4.5 4.6 5a3 3 0 0 0-2.1 2.1C2 9 2 12 2 12s0 3 .5 4.9A3 3 0 0 0 4.6 19c1.9.5 7.4.5 7.4.5s5.5 0 7.4-.5a3 3 0 0 0 2.1-2.1C22 15 22 12 22 12s0-3-.5-4.9Z" />
      <path d="m10 15.4 5.2-3.4L10 8.6v6.8Z" fill="#064e78" />
    </>
  ) : platform === "x" ? (
    <path d="M4.5 3h4.2l4.2 5.6L17.7 3h1.8l-5.8 6.9L20 21h-4.2l-4.7-6.3L5.7 21H3.9l6.4-7.6L4.5 3Zm3.3 1.5H6.9l9.7 15h.9l-9.7-15Z" />
  ) : platform === "linkedin" ? (
    <path d="M5.2 8.4H2V21h3.2V8.4ZM3.6 3A1.9 1.9 0 1 0 3.6 6.8 1.9 1.9 0 0 0 3.6 3ZM21 13.8c0-3.8-2-5.6-4.7-5.6-2.2 0-3.1 1.2-3.7 2V8.4H9.4V21h3.2v-6.2c0-1.7.3-3.3 2.4-3.3 2 0 2.1 1.9 2.1 3.4V21H21v-7.2Z" />
  ) : (
    <>
      <circle cx="12" cy="12" fill="none" r="9" stroke="currentColor" stroke-width="2" />
      <path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9S14.4 18.5 12 21c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z" fill="none" stroke="currentColor" stroke-width="2" />
    </>
  )}
</svg>
