---
import type { Trip } from "../lib/content";

const { description, title, trips } = Astro.props as {
  description?: string;
  title: string;
  trips: Trip[];
};

const loopedTrips = [...trips, ...trips, ...trips];
---

{
  trips.length > 0 && (
    <section class="bg-surface-container-low py-16 md:py-20">
      <div
        class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop"
        data-featured-carousel
        data-trip-count={trips.length}
        style="--featured-gap:1.5rem;--featured-per-page:1;"
      >
        <div class="mb-7 flex items-end justify-between gap-6 md:mb-8">
          <div class="max-w-2xl">
            <h2 class="font-headline-lg text-headline-lg text-primary">{title}</h2>
            {description && <p class="mt-3 text-body-lg text-secondary">{description}</p>}
          </div>
          {trips.length > 1 && (
            <div class="hidden items-center gap-3 md:flex">
              <button
                aria-label="Previous featured trips"
                class="flex h-12 w-12 items-center justify-center rounded-full border border-secondary-fixed bg-white text-primary transition-colors hover:bg-primary hover:text-white"
                data-featured-prev
                type="button"
              >
                <span class="material-symbols-outlined">arrow_back</span>
              </button>
              <button
                aria-label="Next featured trips"
                class="flex h-12 w-12 items-center justify-center rounded-full border border-secondary-fixed bg-white text-primary transition-colors hover:bg-primary hover:text-white"
                data-featured-next
                type="button"
              >
                <span class="material-symbols-outlined">arrow_forward</span>
              </button>
            </div>
          )}
        </div>

        <div class="overflow-hidden" data-featured-viewport>
          <div class="flex transition-transform duration-500 ease-out" data-featured-track style="gap:var(--featured-gap);">
            {loopedTrips.map((trip, index) => (
              <a
                class="group block shrink-0 overflow-hidden rounded-2xl border border-secondary-fixed bg-white shadow-sm transition-shadow hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-4"
                data-featured-card
                data-source-index={index % trips.length}
                href={trip.path}
                style="flex-basis:calc((100% - (var(--featured-gap) * (var(--featured-per-page) - 1))) / var(--featured-per-page));"
              >
                <article class="flex h-[35rem] flex-col">
                  <div class="h-56 overflow-hidden md:h-60">
                    <img
                      alt={trip.coverImage.alt || trip.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      src={trip.coverImage.url}
                    />
                  </div>
                  <div class="flex flex-1 flex-col overflow-hidden p-5 md:p-6">
                    <div class="mb-3 flex flex-wrap items-center gap-2.5">
                      <span class="rounded-full bg-secondary-container px-3 py-1 text-label-sm font-label-sm text-primary">
                        {trip.regionLabel}
                      </span>
                      {trip.isNew && (
                        <span class="rounded-full bg-[#C5A059] px-3 py-1 text-label-sm font-label-sm text-white">
                          New
                        </span>
                      )}
                    </div>
                    <h3 class="min-h-[5.5rem] font-headline-md text-headline-md text-primary [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                      {trip.title}
                    </h3>
                    <p class="mt-2 min-h-[3rem] font-bold text-on-tertiary-container [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                      {trip.dateLabel}
                    </p>
                    <p class="mt-3 h-[7.5rem] overflow-hidden text-body-md leading-6 text-secondary [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:5]">
                      {trip.summary}
                    </p>
                    <span class="mt-auto inline-flex items-center justify-center rounded-lg border border-primary px-6 py-3 font-bold text-primary transition-all group-hover:bg-primary group-hover:text-white">
                      Contact Us
                    </span>
                  </div>
                </article>
              </a>
            ))}
          </div>
        </div>

        {trips.length > 1 && (
          <div class="mt-5 flex items-center justify-center gap-3 md:hidden">
            <button
              aria-label="Previous featured trips"
              class="flex h-11 w-11 items-center justify-center rounded-full border border-secondary-fixed bg-white text-primary transition-colors hover:bg-primary hover:text-white"
              data-featured-prev
              type="button"
            >
              <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <button
              aria-label="Next featured trips"
              class="flex h-11 w-11 items-center justify-center rounded-full border border-secondary-fixed bg-white text-primary transition-colors hover:bg-primary hover:text-white"
              data-featured-next
              type="button"
            >
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  const carousels = document.querySelectorAll("[data-featured-carousel]");

  const getPerPage = () => {
    if (window.innerWidth >= 1280) return 3;
    if (window.innerWidth >= 768) return 2;
    return 1;
  };

  for (const carousel of carousels) {
    const track = carousel.querySelector("[data-featured-track]");
    const cards = Array.from(carousel.querySelectorAll("[data-featured-card]"));
    const previousButtons = Array.from(carousel.querySelectorAll("[data-featured-prev]"));
    const nextButtons = Array.from(carousel.querySelectorAll("[data-featured-next]"));
    const tripCount = Number(carousel.getAttribute("data-trip-count") || "0");

    if (!track || cards.length <= 1 || tripCount <= 1) continue;

    let currentIndex = tripCount;
    let isAnimating = false;

    const setPerPage = () => {
      carousel.style.setProperty("--featured-per-page", String(Math.min(getPerPage(), tripCount)));
    };

    const jumpToIndex = (index, animate) => {
      const targetCard = cards[index];
      if (!targetCard) return;

      track.style.transitionDuration = animate ? "500ms" : "0ms";
      track.style.transform = `translateX(-${targetCard.offsetLeft}px)`;
      currentIndex = index;
    };

    const normalizeIndex = () => {
      if (currentIndex < tripCount) {
        jumpToIndex(currentIndex + tripCount, false);
      } else if (currentIndex >= tripCount * 2) {
        jumpToIndex(currentIndex - tripCount, false);
      }
    };

    const step = (direction) => {
      if (isAnimating) return;

      isAnimating = true;
      jumpToIndex(currentIndex + direction, true);
    };

    track.addEventListener("transitionend", () => {
      isAnimating = false;
      normalizeIndex();
    });

    previousButtons.forEach((button) => {
      button.addEventListener("click", () => step(-1));
    });

    nextButtons.forEach((button) => {
      button.addEventListener("click", () => step(1));
    });

    const handleResize = () => {
      setPerPage();
      jumpToIndex(currentIndex, false);
    };

    window.addEventListener("resize", handleResize);
    setPerPage();
    jumpToIndex(currentIndex, false);
  }
</script>
