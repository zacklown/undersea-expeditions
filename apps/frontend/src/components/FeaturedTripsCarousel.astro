---
import type { Trip } from "../lib/content";

const { description, title, trips } = Astro.props as {
  description?: string;
  title: string;
  trips: Trip[];
};

---

{
  trips.length > 0 && (
    <section class="bg-surface-container-low py-16 md:py-20">
      <div
        class="mx-auto max-w-[1440px] px-margin-mobile md:px-margin-desktop"
        data-featured-carousel
        data-trip-count={trips.length}
        style="--featured-card-width:100%;--featured-gap:1.5rem;"
      >
        <div class="mb-7 md:mb-8">
          <div class="max-w-2xl">
            <h2 class="font-headline-lg text-headline-lg text-[#0066B2]">{title}</h2>
            {description && <p class="mt-3 text-body-lg text-secondary">{description}</p>}
          </div>
        </div>

        <div class="relative 2xl:px-16">
          {trips.length > 1 && (
            <>
              <button
                aria-label="Previous featured trips"
                class="absolute left-0 top-1/2 z-10 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-[#0066B2] text-white shadow-lg transition-colors hover:bg-[#FF6600] 2xl:flex"
                data-featured-prev
                type="button"
              >
                <span class="material-symbols-outlined">arrow_back</span>
              </button>
              <button
                aria-label="Next featured trips"
                class="absolute right-0 top-1/2 z-10 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-[#0066B2] text-white shadow-lg transition-colors hover:bg-[#FF6600] 2xl:flex"
                data-featured-next
                type="button"
              >
                <span class="material-symbols-outlined">arrow_forward</span>
              </button>
            </>
          )}

          <div class="mx-auto max-w-full overflow-hidden xl:w-[70rem]" data-featured-viewport>
            <div class="relative flex transition-transform duration-500 ease-out" data-featured-track style="gap:var(--featured-gap);">
              {trips.map((trip) => (
                <a
                  class="group block shrink-0 overflow-hidden rounded-2xl border border-secondary-fixed bg-white shadow-sm transition-all hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0066B2] focus-visible:ring-offset-4"
                  data-featured-card
                  href={trip.path}
                  style="flex-basis:var(--featured-card-width);"
                >
                <article class="flex h-[43rem] flex-col">
                  <div class="h-56 overflow-hidden md:h-60">
                    <img
                      alt={trip.coverImage.alt || trip.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      src={trip.coverImage.url}
                    />
                  </div>
                  <div aria-hidden="true" class="rainbow-divider h-1 w-full shrink-0"></div>
                  <div class="flex flex-1 flex-col overflow-hidden p-6">
                    <div class="mb-4 flex flex-wrap items-center gap-2.5">
                      <span class="rounded-full bg-secondary-container px-3 py-1 text-label-sm font-label-sm text-primary">
                        {trip.regionLabel}
                      </span>
                      {trip.isNew && (
                        <span class="rounded-full bg-on-tertiary-container px-3 py-1 text-label-sm font-label-sm text-white">
                          New
                        </span>
                      )}
                      {trip.statusLabel && (
                        <span class="rounded-full bg-primary px-3 py-1 text-label-sm font-label-sm text-white">
                          {trip.statusLabel}
                        </span>
                      )}
                    </div>
                    <h3 class="min-h-[5.5rem] font-headline-md text-headline-md text-[#0066B2] [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                      {trip.title}
                    </h3>
                    <p class="mt-2 min-h-[3rem] font-bold text-on-tertiary-container [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                      {trip.dateLabel}
                    </p>
                    <p class="mb-6 mt-3 h-[9rem] overflow-hidden text-ellipsis text-body-md leading-6 text-secondary [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:6]">
                      {trip.summary}
                    </p>
                    <span class="mt-auto inline-flex items-center justify-center rounded-lg border border-[#0066B2] px-6 py-3 font-bold text-[#0066B2] transition-all group-hover:border-[#FF6600] group-hover:bg-[#FF6600] group-hover:text-white">
                      Learn More
                    </span>
                  </div>
                </article>
                </a>
              ))}
            </div>
          </div>
        </div>

        {trips.length > 1 && (
          <div class="mt-5 flex items-center justify-center gap-3 2xl:hidden">
            <button
              aria-label="Previous featured trips"
              class="flex h-11 w-11 items-center justify-center rounded-full bg-[#0066B2] text-white transition-colors hover:bg-[#FF6600]"
              data-featured-prev
              type="button"
            >
              <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <button
              aria-label="Next featured trips"
              class="flex h-11 w-11 items-center justify-center rounded-full bg-[#0066B2] text-white transition-colors hover:bg-[#FF6600]"
              data-featured-next
              type="button"
            >
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  const carousels = document.querySelectorAll("[data-featured-carousel]");

  for (const carousel of carousels) {
    const track = carousel.querySelector("[data-featured-track]");
    const cards = Array.from(carousel.querySelectorAll("[data-featured-card]"));
    const previousButtons = Array.from(carousel.querySelectorAll("[data-featured-prev]"));
    const nextButtons = Array.from(carousel.querySelectorAll("[data-featured-next]"));
    const tripCount = Number(carousel.getAttribute("data-trip-count") || "0");

    if (!track || cards.length <= 1 || tripCount <= 1) continue;

    let currentIndex = 0;
    let isAnimating = false;

    const setCardWidth = () => {
      if (window.innerWidth >= 1280) {
        carousel.style.setProperty("--featured-card-width", "22rem");
        carousel.style.setProperty("--featured-gap", "2rem");
      } else if (window.innerWidth >= 768) {
        carousel.style.setProperty("--featured-card-width", "calc((100% - var(--featured-gap)) / 2)");
        carousel.style.setProperty("--featured-gap", "1.5rem");
      } else {
        carousel.style.setProperty("--featured-card-width", "100%");
        carousel.style.setProperty("--featured-gap", "1.5rem");
      }
    };

    const getVisibleCount = () => {
      if (window.innerWidth >= 1280) return Math.min(3, tripCount);
      if (window.innerWidth >= 768) return Math.min(2, tripCount);
      return 1;
    };

    const jumpToIndex = (index, animate) => {
      if (!cards[index]) return;

      track.style.transitionDuration = animate ? "500ms" : "0ms";
      const cardWidth = cards[0].getBoundingClientRect().width;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = index * (cardWidth + gap);

      track.style.transform = `translate3d(-${distance}px, 0, 0)`;
      currentIndex = index;
    };

    const step = (direction) => {
      if (isAnimating) return;

      const maxIndex = Math.max(0, tripCount - getVisibleCount());
      const nextIndex =
        direction > 0
          ? currentIndex >= maxIndex
            ? 0
            : currentIndex + 1
          : currentIndex <= 0
            ? maxIndex
            : currentIndex - 1;

      if (nextIndex === currentIndex) return;
      isAnimating = true;
      jumpToIndex(nextIndex, true);
    };

    track.addEventListener("transitionend", (event) => {
      if (event.target !== track || event.propertyName !== "transform") return;

      isAnimating = false;
    });

    previousButtons.forEach((button) => {
      button.addEventListener("click", () => step(-1));
    });

    nextButtons.forEach((button) => {
      button.addEventListener("click", () => step(1));
    });

    const handleResize = () => {
      setCardWidth();
      requestAnimationFrame(() => {
        const maxIndex = Math.max(0, tripCount - getVisibleCount());
        jumpToIndex(Math.min(currentIndex, maxIndex), false);
      });
    };

    window.addEventListener("resize", handleResize);
    setCardWidth();
  }
</script>
