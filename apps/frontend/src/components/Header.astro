---
import logo from "../assets/underseax-logo.png";

interface Props {
  active?: "home" | "trips" | "about" | "socials" | "faq" | "contact";
  overlayHero?: boolean;
}

const { active = "home", overlayHero = false } = Astro.props;

const navItems = [
  { key: "home", label: "Home", href: "/" },
  { key: "trips", label: "Trips", href: "/trips" },
  { key: "about", label: "About", href: "/about" },
  { key: "socials", label: "Socials", href: "/socials" },
  { key: "faq", label: "FAQ", href: "/faq" },
];
---

<header
  class:list={[
    "docked full-width inset-x-0 top-0 z-50 w-full",
    overlayHero
      ? "absolute border-b border-outline-variant/30 bg-surface/90 shadow-sm backdrop-blur-md"
      : "sticky border-b border-outline-variant/30 bg-surface/80 shadow-sm backdrop-blur-md dark:border-outline/20 dark:bg-surface-container-highest/80 dark:shadow-none",
  ]}
>
  <div aria-hidden="true" class="rainbow-divider h-1 w-full"></div>
  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-2 max-w-container-max mx-auto">
    <a class="inline-flex items-center" href="/" aria-label="Undersea Expeditions home">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="Undersea Expeditions"
        class="h-24 w-auto lg:h-28"
      />
    </a>

    <nav class="hidden md:flex items-center gap-5 lg:gap-8">
      {navItems.map((item) => (
        <a
          class:list={[
            "font-body-lg text-lg transition-colors relative pb-1 lg:text-xl",
            active === item.key
              ? "text-primary border-b-2 border-on-tertiary-container font-bold"
              : "text-primary hover:text-on-tertiary-container",
          ]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-4">
      <a class="bg-on-tertiary-container px-6 py-3 rounded-full font-body-md text-base uppercase tracking-wider text-white hover:opacity-90 transition-all lg:px-7 lg:text-lg" href="/contact">
        Contact Us
      </a>
    </div>

    <button
      class:list={[
        "md:hidden inline-flex items-center justify-center rounded-full border p-2",
        "border-outline-variant/40 text-primary",
      ]}
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <div id="mobile-nav" class="hidden border-t border-outline-variant/30 bg-surface-container-low/95 md:hidden" data-mobile-nav>
    <nav class="px-margin-mobile py-4">
      <div class="flex flex-col gap-4">
        {navItems.map((item) => (
          <a
            class:list={[
              "font-body-lg text-xl transition-colors",
              active === item.key ? "text-primary font-bold" : "text-primary hover:text-on-tertiary-container",
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector("[data-mobile-nav]");

  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      nav.classList.toggle("hidden", isOpen);
    });
  }
</script>
