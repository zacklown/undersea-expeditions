{
  "name": "apps-cms",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate:payload && next dev -H 0.0.0.0 -p 3001",
    "build": "npm run generate:payload && next build",
    "generate:payload": "npm run generate:types && npm run generate:importmap",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "start": "npm run generate:payload && next start -p 3001"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "next": "16.2.2",
    "payload": "3.84.1",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
